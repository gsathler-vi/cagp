---
// src/components/features/curriculum/CurriculumCentralOverview.astro — Visão Geral da Central Curricular & Grafo 10P
import { OverviewCalcWidget } from '../../widgets/OverviewCalcWidget';
import { OverviewStageWidget } from '../../widgets/OverviewStageWidget';
import { route } from '../../../lib/paths';
---

<div class="cagp-curriculum-central-overview space-y-6 select-none">
  <!-- Apresentação da Central Curricular -->
  <div class="p-4 sm:p-5 bg-[#F7F5F0] border border-[#DFDBD2] rounded-xl flex flex-col sm:flex-row sm:items-center justify-between gap-4 shadow-xs">
    <div class="flex items-start gap-3.5">
      <span class="w-11 h-11 rounded-lg bg-[#15803D] text-white flex items-center justify-center text-xl shrink-0 mt-0.5 shadow-[2px_2px_0px_#0A0A0A]">
        <i class="bi bi-diagram-3-fill" aria-hidden="true" />
      </span>
      <div>
        <div class="flex items-center gap-2">
          <span class="text-[11px] font-['Oswald'] uppercase font-bold tracking-wider text-[#15803D]">
            Central Curricular & Matriz 10P
          </span>
          <span class="text-gray-300">•</span>
          <span class="text-xs text-gray-500 font-mono">3.000 horas de integralização</span>
        </div>
        <h2 class="font-['Oswald'] text-lg sm:text-xl font-bold uppercase text-[#0A0A0A] leading-tight">
          27 Obrigatórias, 68 Optativas, 120h Livres, Estágio e TCC
        </h2>
        <p class="text-xs text-gray-600 mt-1 max-w-3xl leading-relaxed">
          Navegue pela matriz de 10 semestres, adicione disciplinas optativas diretamente nas colunas do Grafo e monitore o seu progresso rumo à colação de grau.
        </p>
      </div>
    </div>
  </div>

  <!-- Bento Grid de Widgets do Currículo -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
    <!-- Card do Grafo Vivo -->
    <div class="cagp-card p-4 bg-white border border-[#DFDBD2] rounded-xl flex flex-col justify-between h-full shadow-sm hover:border-[#0A0A0A] transition-all">
      <div>
        <div class="flex items-center justify-between gap-2 mb-3">
          <div className="flex items-center gap-2">
            <span className="w-9 h-9 rounded-lg bg-[#15803D]/10 text-[#15803D] flex items-center justify-center text-lg border border-[#15803D]/20">
              <i className="bi bi-diagram-3" aria-hidden="true" />
            </span>
            <div>
              <h3 className="font-['Oswald'] font-bold text-sm uppercase text-[#0A0A0A] leading-tight">
                Grafo Dinâmico 10P
              </h3>
              <span className="text-[11px] text-gray-500 font-mono">27 Obrigatórias + Optativas</span>
            </div>
          </div>
          <span className="px-2 py-0.5 rounded font-['Oswald'] text-xs font-bold bg-[#15803D] text-white">
            10 Semestres
          </span>
        </div>
        <p class="text-xs text-gray-700 leading-relaxed mb-3">
          Visualize a teia de pré-requisitos do SIGA e adicione matérias optativas e de formação livre diretamente em cada período do mapa.
        </p>
      </div>
      <a
        href="#grafo"
        class="min-h-[44px] px-3 py-2 bg-[#0A0A0A] text-white hover:bg-[#15803D] rounded-lg font-['Oswald'] text-xs uppercase font-bold tracking-wider flex items-center justify-center gap-2 transition-all no-underline mt-2 shadow-[2px_2px_0px_#0A0A0A]"
      >
        <span>Abrir Grafo Dinâmico</span>
        <i class="bi bi-arrow-right" aria-hidden="true" />
      </a>
    </div>

    <!-- Widgets da Calculadora e do Estágio -->
    <OverviewCalcWidget client:load />
    <OverviewStageWidget client:load />
  </div>

  <!-- Destaque para as 120h de Formação Livre -->
  <div class="p-4 bg-white border border-[#DFDBD2] rounded-xl flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 shadow-xs">
    <div class="flex items-center gap-3">
      <span class="w-10 h-10 rounded-lg bg-[#B45309]/15 text-[#B45309] flex items-center justify-center text-lg shrink-0 border border-[#B45309]/30">
        <i class="bi bi-plus-slash-minus" aria-hidden="true" />
      </span>
      <div>
        <h3 class="font-['Oswald'] text-sm uppercase font-bold text-[#0A0A0A] leading-tight m-0">
          Formação Livre (120h) & Matérias de Outras Unidades
        </h3>
        <p class="text-xs text-gray-600 mt-0.5 m-0">
          Você tem direito a cursar até 120 horas em qualquer departamento da UFMG (Direito, Economia, Ciência da Informação, etc.).
        </p>
      </div>
    </div>

    <a
      href="#grafo"
      class="min-h-[44px] px-4 py-2 bg-[#F7F5F0] hover:bg-[#B45309] hover:text-white border border-[#DFDBD2] hover:border-[#0A0A0A] rounded-lg text-xs font-['Oswald'] uppercase font-bold text-[#0A0A0A] flex items-center gap-2 transition-all no-underline shrink-0"
    >
      <i class="bi bi-pencil-square text-[#B45309] hover:text-white" aria-hidden="true" />
      <span>Inserir no Grafo</span>
    </a>
  </div>
</div>
