---
// src/components/features/acg/AcgCentralOverview.astro — Visão Geral da Central de Horas & Certificados (600h)
import { OverviewCalcWidget } from '../../widgets/OverviewCalcWidget';
import { OverviewGuardianWidget } from '../../widgets/OverviewGuardianWidget';
import { asset } from '../../../lib/paths';
---

<div class="cagp-acg-central-overview space-y-6 select-none">
  <!-- Apresentação da Central de Horas -->
  <div class="p-4 sm:p-5 bg-[#F7F5F0] border border-[#DFDBD2] rounded-xl flex flex-col sm:flex-row sm:items-center justify-between gap-4 shadow-xs">
    <div class="flex items-start gap-3.5">
      <span class="w-11 h-11 rounded-lg bg-[#8B1E2D] text-white flex items-center justify-center text-xl shrink-0 mt-0.5 shadow-[2px_2px_0px_#0A0A0A]">
        <i class="bi bi-clock-history" aria-hidden="true" />
      </span>
      <div>
        <div class="flex items-center gap-2">
          <span class="text-[11px] font-['Oswald'] uppercase font-bold tracking-wider text-[#8B1E2D]">
            Central de Horas & Certificados
          </span>
          <span class="text-gray-300">•</span>
          <span class="text-xs text-gray-500 font-mono">600 horas totais</span>
        </div>
        <h2 class="font-['Oswald'] text-lg sm:text-xl font-bold uppercase text-[#0A0A0A] leading-tight">
          Extensão Obrigatória (300h) & Atividades Acadêmicas Complementares (300h)
        </h2>
        <p class="text-xs text-gray-600 mt-1 max-w-3xl leading-relaxed">
          Monitore sua integralização, cadastre certificados no Guardião de 120 dias e consulte o fluxo oficial de tramitação no SEI/UFMG.
        </p>
      </div>
    </div>
  </div>

  <!-- Bento Grid de Widgets Reativos -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <OverviewCalcWidget client:load />
    <OverviewGuardianWidget client:load />
  </div>

  <!-- Card do Guia de Tramitação & Download do Modelo SEI -->
  <div class="p-4 bg-white border border-[#DFDBD2] rounded-xl flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 shadow-xs">
    <div class="flex items-center gap-3">
      <span class="w-10 h-10 rounded-lg bg-[#0A0A0A] text-white flex items-center justify-center text-lg shrink-0">
        <i class="bi bi-journal-arrow-up" aria-hidden="true" />
      </span>
      <div>
        <h3 class="font-['Oswald'] text-sm uppercase font-bold text-[#0A0A0A] leading-tight m-0">
          Requerimento Oficial de AAC (Versão N-20229)
        </h3>
        <p class="text-xs text-gray-600 mt-0.5 m-0">
          Formulário padrão do Colegiado para abertura de processo de aproveitamento no SEI.
        </p>
      </div>
    </div>

    <a
      href={asset('/documentos/requerimento-atividade-integralizadora-credito-v20229.pdf')}
      download
      class="min-h-[44px] px-4 py-2 bg-[#F7F5F0] hover:bg-[#8B1E2D] hover:text-white border border-[#DFDBD2] hover:border-[#0A0A0A] rounded-lg text-xs font-['Oswald'] uppercase font-bold text-[#0A0A0A] flex items-center gap-2 transition-all no-underline shrink-0"
    >
      <i class="bi bi-file-earmark-pdf-fill text-[#8B1E2D] hover:text-white" aria-hidden="true" />
      <span>Baixar PDF</span>
    </a>
  </div>
</div>
