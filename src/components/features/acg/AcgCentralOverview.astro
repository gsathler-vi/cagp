---
// src/components/features/acg/AcgCentralOverview.astro — Visão Geral da Central de Horas & Certificados (600h)
import { AcgCalculatorWidget } from './calculator/AcgCalculatorWidget';
import { AcgGuardianWidget } from './guardian/AcgGuardianWidget';
import AcgTramitacaoWidget from './tramitacao/AcgTramitacaoWidget.astro';
import { asset } from '../../../lib/paths';
---

<div class="cagp-acg-central-overview space-y-6 select-none">
  <!-- Apresentação da Central de Horas -->
  <div class="p-4 sm:p-5 bg-[#F7F5F0] border border-[#DFDBD2] rounded-xl flex flex-col sm:flex-row sm:items-center justify-between gap-4 shadow-xs">
    <div class="flex items-start gap-3.5">
      <span class="w-11 h-11 rounded-lg bg-[#8B1E2D] text-white flex items-center justify-center text-xl shrink-0 mt-0.5 shadow-[2px_2px_0px_#0A0A0A]">
        <i class="bi bi-clock-history" aria-hidden="true" />
      </span>
      <div>
        <div class="flex items-center gap-2">
          <span class="text-[11px] font-['Oswald'] uppercase font-bold tracking-wider text-[#8B1E2D]">
            Central de Horas & Certificados
          </span>
          <span class="text-gray-300">•</span>
          <span class="text-xs text-gray-500 font-mono">600 horas totais</span>
        </div>
        <h2 class="font-['Oswald'] text-lg sm:text-xl font-bold uppercase text-[#0A0A0A] leading-tight m-0">
          Extensão Obrigatória (300h) & Atividades Complementares (AAC • 300h)
        </h2>
        <p class="text-xs text-gray-600 mt-1 max-w-3xl leading-relaxed m-0">
          Monitore sua integralização, cadastre certificados no Guardião de 120 dias corridos e consulte o protocolo oficial do Colegiado (Formulário N-20229).
        </p>
      </div>
    </div>
  </div>

  <!-- Bento Grid de Widgets Reativos -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
    <AcgCalculatorWidget client:load />
    <AcgGuardianWidget client:load />
    <AcgTramitacaoWidget />
  </div>

  <!-- Banner de Acesso Rápido ao Formulário N-20229 -->
  <div class="p-4 bg-white border border-[#DFDBD2] rounded-xl flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 shadow-xs">
    <div class="flex items-center gap-3">
      <span class="w-10 h-10 rounded-lg bg-[#0A0A0A] text-white flex items-center justify-center text-lg shrink-0">
        <i class="bi bi-file-earmark-pdf-fill" aria-hidden="true" />
      </span>
      <div>
        <h3 class="font-['Oswald'] text-sm uppercase font-bold text-[#0A0A0A] leading-tight m-0">
          Requerimento Oficial de AAC (Versão N-20229)
        </h3>
        <p class="text-xs text-gray-600 mt-0.5 m-0">
          Formulário padrão do Colegiado para solicitação de aproveitamento de carga horária.
        </p>
      </div>
    </div>

    <div class="flex items-center gap-2 w-full sm:w-auto">
      <a
        href={asset('/documentos/requerimento-atividade-integralizadora-credito-v20229.pdf')}
        download
        class="min-h-[44px] flex-1 sm:flex-none px-4 py-2 bg-[#8B1E2D] hover:bg-[#0A0A0A] text-white rounded-lg text-xs font-['Oswald'] uppercase font-bold tracking-wider flex items-center justify-center gap-2 transition-all no-underline shadow-[2px_2px_0px_#0A0A0A]"
      >
        <i class="bi bi-download" aria-hidden="true" />
        <span>Baixar PDF</span>
      </a>
      <a
        href="#protocolo-colegiado"
        class="min-h-[44px] px-3 py-2 bg-[#F7F5F0] hover:bg-[#EAE6DE] text-[#0A0A0A] border border-[#DFDBD2] rounded-lg text-xs font-['Oswald'] uppercase font-bold flex items-center justify-center transition-all no-underline"
      >
        <span>Ver Guia</span>
      </a>
    </div>
  </div>
</div>
