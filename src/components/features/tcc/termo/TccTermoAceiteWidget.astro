---
// src/components/features/tcc/termo/TccTermoAceiteWidget.astro — Widget de Resumo do Termo de Aceite
import { asset } from '../../../../lib/paths';
---

<div class="cagp-card p-4 bg-white border border-[#DFDBD2] rounded-xl flex flex-col justify-between h-full shadow-xs hover:border-[#0A0A0A] transition-all select-none">
  <div>
    <div class="flex items-center justify-between gap-2 mb-3">
      <div class="flex items-center gap-2">
        <span class="w-9 h-9 rounded-lg bg-[#8B1E2D]/10 text-[#8B1E2D] flex items-center justify-center text-lg border border-[#8B1E2D]/20">
          <i class="bi bi-file-earmark-check-fill" aria-hidden="true" />
        </span>
        <div>
          <h3 class="font-['Oswald'] font-bold text-sm uppercase text-[#0A0A0A] leading-tight m-0">
            Termo de Aceite
          </h3>
          <span class="text-[11px] text-gray-500 font-mono">Pré-requisito DCP 089</span>
        </div>
      </div>
      <span class="px-2 py-0.5 rounded font-['Oswald'] text-[11px] font-bold bg-[#8B1E2D] text-white">
        Obrigatório
      </span>
    </div>

    <p class="text-xs text-gray-700 leading-relaxed mb-3">
      Documento firmado com seu(sua) professor(a) orientador(a) antes de solicitar matrícula em Projeto de TCC no SIGA.
    </p>

    <div class="p-2.5 bg-[#F7F5F0] border border-[#DFDBD2] rounded-lg mb-3 flex items-center justify-between text-xs">
      <span class="text-gray-600">Formato Disponível:</span>
      <span class="font-mono font-bold text-[#0A0A0A]">PDF e DOCX</span>
    </div>
  </div>

  <div class="flex items-center gap-2 pt-2 border-t border-[#DFDBD2]">
    <a
      href="#termo-aceite"
      class="flex-1 min-h-[44px] px-3 py-2 bg-[#0A0A0A] hover:bg-[#8B1E2D] text-white rounded-lg font-['Oswald'] text-xs uppercase font-bold tracking-wider flex items-center justify-center gap-1.5 transition-all no-underline shadow-[2px_2px_0px_#0A0A0A]"
    >
      <span>Orientações & Regras</span>
      <i class="bi bi-arrow-right" aria-hidden="true" />
    </a>
    <a
      href={asset('/documentos/termo-aceite-orientador-tcc.pdf')}
      download
      class="min-h-[44px] min-w-[44px] px-3 py-2 bg-[#F7F5F0] hover:bg-[#EAE6DE] text-[#0A0A0A] border border-[#DFDBD2] rounded-lg flex items-center justify-center transition-all no-underline shrink-0"
      title="Baixar Termo de Aceite em PDF"
      aria-label="Baixar Termo de Aceite em PDF"
    >
      <i class="bi bi-file-earmark-pdf-fill text-[#8B1E2D] text-base" aria-hidden="true" />
    </a>
  </div>
</div>
