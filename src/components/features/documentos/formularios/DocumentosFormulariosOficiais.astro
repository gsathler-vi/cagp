---
// src/components/features/documentos/formularios/DocumentosFormulariosOficiais.astro — Formulários Oficiais e Modelos de Requerimento
import { asset } from '../../../../lib/paths';

const formularios = [
  { title: 'Requerimento de AAC / Horas (N-20229)', file: 'requerimento-atividade-integralizadora-credito-v20229.pdf', desc: 'Protocolo oficial de certificados no Colegiado com limite fatal de 120 dias.', badge: 'Colegiado N-20229' },
  { title: 'Dispensa de Estágio Art. 41 (Requerimento)', file: 'estagio-requerimento-integralizacao-experiencia-profissional.pdf', desc: 'Integralização por experiência profissional como servidor ou terceiro setor.', badge: 'Art. 41' },
  { title: 'Relatório de Atividades Art. 41', file: 'estagio-relatorio-atividades-experiencia-profissional.pdf', desc: 'Comprovação semestral de atribuições para avaliação de estágio.', badge: 'Art. 41' },
  { title: 'Termo de Aceite de Orientador de TCC', file: 'termo-aceite-orientador-tcc.pdf', desc: 'Requisito obrigatório para matrícula em DCP 089 (9ºP).', badge: 'TCC 9ºP' },
  { title: 'Requerimento de Matrícula Formação Livre', file: 'requerimento-matricula-formacao-livre.pdf', desc: 'Protocolo para cursar 120h em outras unidades da UFMG.', badge: '120h Livre' },
  { title: 'Termo de Compromisso de Estágio com Convênio', file: 'estagio-modelo-termo-de-compromisso-com-convenio.pdf', desc: 'Modelo oficial com interveniência para órgãos conveniados.', badge: 'TCE Obrigatório' },
  { title: 'Termo de Compromisso de Estágio sem Vínculo', file: 'estagio-modelo-termo-de-compromisso-sem-vinculo.pdf', desc: 'Modelo para órgãos via agentes integradores de estágio.', badge: 'TCE Geral' },
  { title: 'Plano de Atividades de Estágio', file: 'estagio-modelo-plano-de-atividades.pdf', desc: 'Cronograma e plano assinado para deferimento no Colegiado.', badge: 'Estágio' },
  { title: 'Relatório Final de Estágio Supervisionado', file: 'estagio-modelo-relatorio-final.pdf', desc: 'Entrega final para integralização de DCP 135 ou DCP 136.', badge: 'Estágio' },
];
---

<div class="cagp-documentos-formularios space-y-4 select-none text-[#0A0A0A]">
  <div class="p-4 bg-white border border-[#DFDBD2] rounded-xl flex flex-col sm:flex-row sm:items-center justify-between gap-3 shadow-xs">
    <div>
      <span class="text-[11px] font-['Oswald'] uppercase font-bold tracking-wider text-[#8B1E2D]">
        Modelos e Requerimentos Padronizados
      </span>
      <h3 class="font-['Oswald'] text-base font-bold uppercase text-[#0A0A0A] m-0">
        Formulários Oficiais para Protocolo
      </h3>
      <p class="text-xs text-gray-600 mt-0.5 m-0">
        Modelos homologados pelo Colegiado de Gestão Pública e pela Diretoria da FAFICH.
      </p>
    </div>
    <span class="px-2.5 py-1 rounded bg-[#0A0A0A] text-white font-mono text-xs font-bold shrink-0">
      {formularios.length} Modelos
    </span>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
    {formularios.map((doc) => (
      <div class="cagp-card p-4 bg-white border border-[#DFDBD2] hover:border-[#0A0A0A] rounded-xl flex items-center justify-between gap-3 transition-all shadow-xs">
        <div class="flex items-start gap-3 min-w-0">
          <div class="w-9 h-9 rounded-lg bg-[#8B1E2D]/10 text-[#8B1E2D] border border-[#8B1E2D]/20 flex items-center justify-center shrink-0 mt-0.5">
            <i class="bi bi-file-earmark-check-fill text-base" aria-hidden="true" />
          </div>
          <div class="min-w-0">
            <div class="flex items-center gap-1.5 mb-1 flex-wrap">
              <span class="cagp-badge cagp-badge-red text-[10px] font-mono">{doc.badge}</span>
              <h4 class="font-['Oswald'] font-bold text-xs uppercase text-[#0A0A0A] truncate m-0">{doc.title}</h4>
            </div>
            <p class="text-xs text-gray-600 leading-tight m-0">{doc.desc}</p>
          </div>
        </div>

        <a
          href={asset(`/documentos/${doc.file}`)}
          download
          class="min-h-[40px] px-3 py-1.5 bg-[#0A0A0A] hover:bg-[#8B1E2D] text-white rounded-lg text-xs font-['Oswald'] uppercase font-bold tracking-wider flex items-center gap-1.5 transition-all no-underline shrink-0 shadow-[1px_1px_0px_#0A0A0A]"
          title={`Baixar ${doc.title}`}
        >
          <i class="bi bi-download" aria-hidden="true" />
          <span>Baixar</span>
        </a>
      </div>
    ))}
  </div>
</div>
