---
// src/components/features/documentos/atos/DocumentosAtosRegulamentares.astro — Atos Normativos e Regulamentares Oficiais
import { asset, route } from '../../../../lib/paths';

const atos = [
  { title: 'Projeto Pedagógico do Curso (PPC 2020)', file: 'ppc-gestao-publica-ufmg.pdf', readerSlug: 'ppc-gestao-publica-ufmg', desc: 'Estrutura completa de 3.000h, competências e perfil de formação.', badge: 'Documento Mestre' },
  { title: 'Regulamento do Curso Versão N-20229', file: 'regulamento-gestao-publica-ufmg.pdf', readerSlug: 'regulamento-gestao-publica-ufmg', desc: 'Normas de integralização, AAC, estágio e culminância de TCC.', badge: 'Norma Vigente' },
  { title: 'Regimento Interno do CAGP (14/10/2024)', file: 'regimento-interno-cagp-ufmg.pdf', readerSlug: 'regimento-interno-cagp-ufmg', desc: 'Estatuto soberano aprovado pela Assembleia Geral Discente.', badge: 'Entidade Discente' },
  { title: 'Matriz Percurso 01-01 (Bacharelado Geral)', file: 'percurso-bacharelado-nucleo-geral.pdf', readerSlug: 'percurso-bacharelado-nucleo-geral', desc: '1.020h em optativas com máxima flexibilidade curricular.', badge: 'Percurso 01-01' },
  { title: 'Matriz Percurso 01-02 (Núcleo Complementar)', file: 'percurso-bacharelado-nucleo-complementar.pdf', readerSlug: 'percurso-bacharelado-nucleo-complementar', desc: '300h em Formação Transversal ou Aberta (FCA).', badge: 'Percurso 01-02' },
  { title: 'Matriz Percurso 01-03 (Núcleo Avançado Pós)', file: 'percurso-bacharelado-nucleo-avancado.pdf', readerSlug: 'percurso-bacharelado-nucleo-avancado', desc: 'Disciplinas de mestrado/doutorado no PPGCP/FAFICH.', badge: 'Percurso 01-03' },
  { title: 'Ementário Oficial do Curso de Gestão Pública', file: 'ementario-gestao-publica-ufmg.pdf', readerSlug: 'ementario-gestao-publica-ufmg', desc: 'Ementas, pré-requisitos e créditos das 27 obrigatórias e 68 optativas.', badge: 'Ementário Geral' },
  { title: 'Transcrição Recepção Ingressantes 2024/2', file: 'recepcao-ingressantes-2024-2.pdf', readerSlug: 'transcricao-recepcao-ingressantes-2024-2', desc: 'Apresentação oficial de acolhimento discente pela Coordenação (49 slides).', badge: 'Acolhimento Calouro' },
  { title: 'Resolução CEPE 06/2019 (Aproveitamento)', file: 'resolucao-cepe-06-2019-aproveitamento-estudos.pdf', desc: 'Aproveitamento de estudos com prazo fatal até o final do 2º período letivo.', badge: 'CEPE / UFMG' },
];
---

<div class="cagp-documentos-atos space-y-4 select-none text-[#0A0A0A]">
  <div class="p-4 bg-white border border-[#DFDBD2] rounded-xl flex flex-col sm:flex-row sm:items-center justify-between gap-3 shadow-xs">
    <div>
      <span class="text-[11px] font-['Oswald'] uppercase font-bold tracking-wider text-[#8B1E2D]">
        Atos Normativos e Fundacionais
      </span>
      <h3 class="font-['Oswald'] text-base font-bold uppercase text-[#0A0A0A] m-0">
        Legislação, PPC 2020 e Regulamentos
      </h3>
      <p class="text-xs text-gray-600 mt-0.5 m-0">
        Documentos oficiais que regem a estrutura curricular, direitos e obrigações discentes.
      </p>
    </div>
    <span class="px-2.5 py-1 rounded bg-[#0A0A0A] text-white font-mono text-xs font-bold shrink-0">
      {atos.length} Atos Vigentes
    </span>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
    {atos.map((doc, idx) => (
      <div class="cagp-card p-4 bg-white border border-[#DFDBD2] hover:border-[#0A0A0A] rounded-xl flex items-center justify-between gap-3 transition-all shadow-xs">
        <div class="flex items-start gap-3 min-w-0">
          <div class="w-9 h-9 rounded-lg bg-[#8B1E2D]/10 text-[#8B1E2D] border border-[#8B1E2D]/20 flex items-center justify-center shrink-0 mt-0.5">
            <i class="bi bi-file-earmark-ruled-fill text-base" aria-hidden="true" />
          </div>
          <div class="min-w-0">
            <div class="flex items-center gap-1.5 mb-1 flex-wrap">
              <span class="cagp-badge cagp-badge-red text-[10px] font-mono">{doc.badge}</span>
              <h4 class="font-['Oswald'] font-bold text-xs uppercase text-[#0A0A0A] truncate m-0">{doc.title}</h4>
            </div>
            <p class="text-xs text-gray-600 leading-tight m-0">{doc.desc}</p>
          </div>
        </div>

        <div class="flex items-center gap-1.5 shrink-0">
          {doc.readerSlug && (
            <a
              href={route(`/documentos/${doc.readerSlug}`)}
              class="min-h-[40px] px-2.5 py-1.5 bg-[#F7F5F0] hover:bg-[#EAE6DE] text-[#0A0A0A] border border-[#DFDBD2] rounded-lg text-xs font-['Oswald'] uppercase font-bold flex items-center gap-1 transition-all no-underline"
              title="Abrir leitor integrado"
            >
              <i class="bi bi-book-half" aria-hidden="true" />
              <span class="hidden sm:inline">Ler</span>
            </a>
          )}
          <a
            href={asset(`/documentos/${doc.file}`)}
            download
            class="min-h-[40px] min-w-[40px] px-2.5 py-1.5 bg-[#0A0A0A] hover:bg-[#8B1E2D] text-white rounded-lg flex items-center justify-center transition-all no-underline shadow-[1px_1px_0px_#0A0A0A]"
            title={`Baixar ${doc.title}`}
            aria-label={`Baixar ${doc.title}`}
          >
            <i class="bi bi-download" aria-hidden="true" />
          </a>
        </div>
      </div>
    ))}
  </div>
</div>
