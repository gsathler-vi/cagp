---
// src/components/features/cagp/historia/CagpHistoriaCore.astro — Princípios Republicano e História dos Candangos
import SobrePrincipios from '../../../sobre/SobrePrincipios.astro';
---

<div class="cagp-historia-core space-y-6 select-none text-[#0A0A0A]">
  <div class="p-4 bg-white border border-[#DFDBD2] rounded-xl flex flex-col sm:flex-row sm:items-center justify-between gap-3 shadow-xs">
    <div>
      <span class="text-[11px] font-['Oswald'] uppercase font-bold tracking-wider text-[#8B1E2D]">
        História & Identidade Discente
      </span>
      <h3 class="font-['Oswald'] text-base font-bold uppercase text-[#0A0A0A] m-0">
        Os Candangos e a Luta por Gestão Pública
      </h3>
      <p class="text-xs text-gray-600 mt-0.5 m-0">
        Princípios constitucionais da administração pública aplicados à representação estudantil na FAFICH.
      </p>
    </div>
    <span class="px-2.5 py-1 rounded bg-[#0A0A0A] text-white font-mono text-xs font-bold shrink-0">
      Desde 2009 na UFMG
    </span>
  </div>

  <SobrePrincipios />
</div>
