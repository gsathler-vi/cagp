---
// src/components/features/cagp/estatuto/CagpEstatutoCore.astro — Regimento Interno de 14/10/2024 e Instâncias Deliberativas
import SobreGovernanca from '../../../sobre/SobreGovernanca.astro';
import SobreEsferas from '../../../sobre/SobreEsferas.astro';
---

<div class="cagp-estatuto-core space-y-6 select-none text-[#0A0A0A]">
  <div class="p-4 bg-white border border-[#DFDBD2] rounded-xl flex flex-col sm:flex-row sm:items-center justify-between gap-3 shadow-xs">
    <div>
      <span class="text-[11px] font-['Oswald'] uppercase font-bold tracking-wider text-[#8B1E2D]">
        Regimento Interno Aprovado em 14/10/2024
      </span>
      <h3 class="font-['Oswald'] text-base font-bold uppercase text-[#0A0A0A] m-0">
        Governança, Instâncias Deliberativas e Estatuto
      </h3>
      <p class="text-xs text-gray-600 mt-0.5 m-0">
        Estrutura de poder baseada na soberania da Assembleia Geral e participação democrática discente.
      </p>
    </div>
    <span class="px-2.5 py-1 rounded bg-[#0A0A0A] text-white font-mono text-xs font-bold shrink-0">
      Estatuto Vigente
    </span>
  </div>

  <SobreGovernanca />
  <SobreEsferas />
</div>
