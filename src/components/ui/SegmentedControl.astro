---
// SegmentedControl.astro - Controle Segmentado por N (Contrato 5.1)
interface TabItem {
  id: string;
  shortLabel: string;
  fullLabel: string;
  hash: string;
}

interface Props {
  tabs: TabItem[];
  defaultTab?: string;
}

const { tabs, defaultTab = tabs[0]?.id } = Astro.props;
---

<nav class="cagp-workspace-bar" aria-label="Abas operacionais da página">
  <div class="cagp-workspace-tabs" role="tablist" data-tab-count={tabs.length}>
    {tabs.map((tab) => {
      const isSelected = tab.id === defaultTab;
      return (
        <button
          type="button"
          class={`cagp-workspace-tab ${isSelected ? 'is-active' : ''}`}
          role="tab"
          id={`ws-tab-${tab.id}`}
          aria-controls={`ws-panel-${tab.id}`}
          aria-selected={isSelected ? 'true' : 'false'}
          tabindex={isSelected ? 0 : -1}
          data-ws-tab={tab.id}
          data-ws-hash={tab.hash}
        >
          <span class="cagp-tab-label-full">{tab.fullLabel}</span>
          <span class="cagp-tab-label-short" aria-hidden="true">{tab.shortLabel}</span>
        </button>
      );
    })}
  </div>
  <button
    type="button"
    class="cagp-workspace-viewall"
    aria-pressed="false"
    aria-label="Ver todas as abas"
    data-ws-tab="__all__"
    data-ws-hash="#visao-completa"
  >
    <i class="bi bi-layout-text-sidebar" aria-hidden="true"></i>
  </button>
</nav>

<script>
  function setupWorkspaceTabs() {
    const bars = document.querySelectorAll('.cagp-workspace-bar');
    bars.forEach((bar) => {
      const tabs = bar.querySelectorAll<HTMLButtonElement>('.cagp-workspace-tab');
      const viewAllBtn = bar.querySelector<HTMLButtonElement>('.cagp-workspace-viewall');
      const panels = document.querySelectorAll<HTMLElement>('.cagp-workspace-view');

      function activate(tabId: string, updateHash = true) {
        if (tabId === '__all__') {
          tabs.forEach((t) => {
            t.classList.remove('is-active');
            t.setAttribute('aria-selected', 'false');
            t.tabIndex = -1;
          });
          viewAllBtn?.setAttribute('aria-pressed', 'true');
          viewAllBtn?.classList.add('is-active');
          panels.forEach((p) => p.removeAttribute('hidden'));
          if (updateHash) history.replaceState(null, '', '#visao-completa');
          return;
        }

        viewAllBtn?.setAttribute('aria-pressed', 'false');
        viewAllBtn?.classList.remove('is-active');

        tabs.forEach((t) => {
          const isMatch = t.getAttribute('data-ws-tab') === tabId;
          t.classList.toggle('is-active', isMatch);
          t.setAttribute('aria-selected', isMatch ? 'true' : 'false');
          t.tabIndex = isMatch ? 0 : -1;
          if (isMatch && updateHash) {
            const h = t.getAttribute('data-ws-hash');
            if (h) history.replaceState(null, '', h);
          }
        });

        panels.forEach((p) => {
          const panelId = p.getAttribute('data-ws-panel') || p.id.replace('ws-panel-', '');
          if (panelId === tabId) {
            p.removeAttribute('hidden');
            p.classList.remove('cagp-animate-ws-enter');
            void p.offsetWidth;
            p.classList.add('cagp-animate-ws-enter');
          } else {
            p.setAttribute('hidden', '');
            p.classList.remove('cagp-animate-ws-enter');
          }
        });
      }

      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => {
          const id = tab.getAttribute('data-ws-tab');
          if (id) activate(id);
        });

        // Keyboard navigation (ArrowLeft / ArrowRight) with roving tabindex
        tab.addEventListener('keydown', (e) => {
          let nextIndex = index;
          if (e.key === 'ArrowRight') {
            nextIndex = (index + 1) % tabs.length;
          } else if (e.key === 'ArrowLeft') {
            nextIndex = (index - 1 + tabs.length) % tabs.length;
          } else {
            return;
          }
          e.preventDefault();
          tabs[nextIndex].focus();
          const nextId = tabs[nextIndex].getAttribute('data-ws-tab');
          if (nextId) activate(nextId);
        });
      });

      viewAllBtn?.addEventListener('click', () => {
        const isPressed = viewAllBtn.getAttribute('aria-pressed') === 'true';
        if (isPressed) {
          const firstTab = tabs[0]?.getAttribute('data-ws-tab');
          if (firstTab) activate(firstTab);
        } else {
          activate('__all__');
        }
      });

      // Match current window location hash on load
      const hash = window.location.hash;
      if (hash === '#visao-completa') {
        activate('__all__', false);
      } else if (hash) {
        const matchingTab = Array.from(tabs).find((t) => t.getAttribute('data-ws-hash') === hash);
        if (matchingTab) {
          const id = matchingTab.getAttribute('data-ws-tab');
          if (id) activate(id, false);
        }
      }
    });
  }

  document.addEventListener('astro:page-load', setupWorkspaceTabs);
</script>
