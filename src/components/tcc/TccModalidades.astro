---
// TccModalidades.astro - Sub-view 1: Etapas curriculares e matriz das 4 modalidades de TCC
const modalidades = [
  {
    num: 1,
    nome: 'Monografia Científica Tradicional',
    icon: 'bi-journal-richtext',
    badge: 'Perfil Acadêmico',
    badgeVariant: 'dark' as const,
    foco: 'Domínio teórico-analítico e revisão exaustiva da literatura especializada.',
    estrutura: 'Texto monográfico completo com problema de pesquisa, metodologia e análise empírica/documental detalhada.',
    sinergia: 'Indicada para discentes que visam ingresso em programas de Mestrado Acadêmico (ex.: PPGCP/UFMG) e docência.',
  },
  {
    num: 2,
    nome: 'Projeto de Intervenção Governamental',
    icon: 'bi-kanban-fill',
    badge: 'Perfil Aplicado',
    badgeVariant: 'red' as const,
    foco: 'Resolução aplicada de problema real em órgão público, política pública ou OSC.',
    estrutura: 'Diagnóstico situacional estruturado + Plano executivo de melhoria, modernização institucional ou intervenção.',
    sinergia: 'Aproveitamento direto de dados, diagnósticos e vivências do Estágio Obrigatório (DCP 135/136) ou serviço público.',
  },
  {
    num: 3,
    nome: 'Artigo Científico para Publicação',
    icon: 'bi-file-earmark-text-fill',
    badge: 'Perfil Periódico',
    badgeVariant: 'blue' as const,
    foco: 'Teste objetivo de hipóteses no formato de periódicos científicos indexados (Qualis/CAPES).',
    estrutura: 'Artigo autoral inédito formatado segundo normas de periódicos acadêmicos da área de Gestão Pública/Ciência Política.',
    sinergia: 'Excelente para bolsistas e pesquisadores dos 11 Núcleos de Pesquisa do DCP que visam publicação científica.',
  },
  {
    num: 4,
    nome: 'Projeto de Iniciação Científica Avançado',
    icon: 'bi-search',
    badge: 'Perfil Pesquisa',
    badgeVariant: 'gold' as const,
    foco: 'Desenho metodológico avançado para investigação futura de fôlego.',
    estrutura: 'Projeto completo contendo justificativa, estado da arte, hipóteses e matriz operacional de coleta de dados.',
    sinergia: 'Recomendado para alunos com planos de editais de fomento científico ou anteprojeto de seleção para pós-graduação.',
  },
];
---

<div class="space-y-4 text-[#0A0A0A]">
  <!-- As 2 Etapas Curriculares Bento -->
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
    <div class="cagp-card p-4 bg-white space-y-2">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2">
          <i class="bi bi-compass-fill text-[#8B1E2D] text-base" aria-hidden="true"></i>
          <span class="text-xs font-mono font-bold bg-[#0A0A0A] text-white px-2 py-0.5 rounded-[4px]">DCP 089</span>
        </div>
        <span class="text-xs font-mono text-[#8B1E2D] font-bold">9ºP • 60h (4 créditos)</span>
      </div>
      <h3 class="font-['Oswald'] font-bold text-sm uppercase text-[#0A0A0A]">Projeto de TCC</h3>
      <p class="text-xs text-gray-600 leading-relaxed">
        Delimitação do problema de pesquisa empírico ou teórico, justificativa, revisão bibliográfica e desenho metodológico. A matrícula exige a entrega do Termo de Aceite assinado pelo docente orientador.
      </p>
    </div>

    <div class="cagp-card p-4 bg-white space-y-2">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2">
          <i class="bi bi-award-fill text-[#8B1E2D] text-base" aria-hidden="true"></i>
          <span class="text-xs font-mono font-bold bg-[#8B1E2D] text-white px-2 py-0.5 rounded-[4px]">DCP 137</span>
        </div>
        <span class="text-xs font-mono text-[#8B1E2D] font-bold">10ºP • 120h (8 créditos)</span>
      </div>
      <h3 class="font-['Oswald'] font-bold text-sm uppercase text-[#0A0A0A]">Trabalho de Conclusão & Defesa</h3>
      <p class="text-xs text-gray-600 leading-relaxed">
        Conclusão da análise empírica, redação final e sustentação perante banca examinadora pública de pelo menos 2 docentes. Exige-se nota mínima de 60 pontos em 100 para aprovação.
      </p>
    </div>
  </div>

  <!-- As 4 Modalidades Oficiais (Art. 19) -->
  <div class="cagp-tool-box p-4 space-y-3">
    <div class="border-b border-[#DFDBD2] pb-2.5 flex items-center justify-between flex-wrap gap-2">
      <div>
        <div class="flex items-center gap-2">
          <i class="bi bi-journal-check text-[#8B1E2D] text-lg" aria-hidden="true"></i>
          <h3 class="font-['Oswald'] text-base font-bold uppercase text-[#0A0A0A]">
            As 4 Modalidades Oficiais de TCC (Art. 19, Parágrafo Único)
          </h3>
        </div>
        <p class="text-xs text-gray-600 mt-0.5">
          Escolha o formato que melhor se alinha à sua trajetória acadêmica ou profissional:
        </p>
      </div>
      <span class="cagp-badge cagp-badge-red font-mono">
        Regulamento FAFICH
      </span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      {modalidades.map((m) => (
        <div class="cagp-card p-3.5 bg-white flex flex-col justify-between space-y-2">
          <div>
            <div class="flex items-center justify-between mb-2">
              <div class="flex items-center gap-2">
                <div class="w-8 h-8 rounded-[4px] bg-[#F7F5F0] border border-[#DFDBD2] flex items-center justify-center text-[#8B1E2D] shrink-0 shadow-[1px_1px_0_#0A0A0A]">
                  <i class={`bi ${m.icon} text-sm`} aria-hidden="true" />
                </div>
                <span class="font-['Oswald'] font-bold text-xs uppercase text-[#0A0A0A]">
                  {m.num}. {m.nome}
                </span>
              </div>
              <span class={`cagp-badge ${
                m.badgeVariant === 'red' ? 'cagp-badge-red' :
                m.badgeVariant === 'dark' ? 'cagp-badge-dark' :
                m.badgeVariant === 'blue' ? 'cagp-badge-blue' :
                'cagp-badge-gold'
              } text-xs font-mono`}>
                {m.badge}
              </span>
            </div>
            <p class="text-xs text-gray-700 leading-relaxed mb-2">{m.foco}</p>
            <div class="text-xs bg-[#F7F5F0] p-2.5 rounded-[4px] border border-[#DFDBD2] space-y-1">
              <p><strong>Estrutura:</strong> {m.estrutura}</p>
            </div>
          </div>
          <div class="pt-2 border-t border-[#DFDBD2]">
            <span class="text-xs text-[#8B1E2D] font-medium leading-tight block">
              💡 <strong>Sinergia:</strong> {m.sinergia}
            </span>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>