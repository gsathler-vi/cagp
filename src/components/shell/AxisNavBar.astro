---
// src/components/shell/AxisNavBar.astro — Barra de Pílulas do Eixo (Apple HIG & Neo-Brutalista CAGP)
import {
  type AxisId,
  getAxisById,
  getAxisByPath,
  getActiveItemId,
} from '../../lib/navigationRegistry';

interface Props {
  axisId?: AxisId;
  activeId?: string;
  showBadge?: boolean;
  className?: string;
}

const {
  axisId: explicitAxisId,
  activeId: explicitActiveId,
  showBadge = true,
  className = '',
} = Astro.props;

// Resolução inteligente do Eixo a partir da rota atual se não fornecido
const currentPath = Astro.url.pathname;
const axis = explicitAxisId ? getAxisById(explicitAxisId) : getAxisByPath(currentPath);

// Se não estiver em um dos eixos (ex: página especial isolada), não renderiza
const activeItemId = axis
  ? explicitActiveId || getActiveItemId(axis, currentPath, Astro.url.hash)
  : '';
---

{axis && (
  <nav
    class={`cagp-axis-navbar-wrap mb-4 select-none ${className}`}
    aria-label={`Navegação do Eixo ${axis.number}: ${axis.name}`}
  >
    <div class="cagp-axis-navbar-container flex items-center gap-1.5 overflow-x-auto py-1 scrollbar-none">
      {/* Badge do Eixo */}
      {showBadge && (
        <div class="cagp-axis-badge shrink-0 flex items-center gap-1.5 px-2.5 py-1.5 bg-[#0A0A0A] text-[#FFFFFF] rounded-md border border-[#0A0A0A] text-xs font-['Oswald'] uppercase tracking-wider font-bold">
          <i class={`bi ${axis.icon} text-sm text-[#FF8718]`} aria-hidden="true" />
          <span>{axis.name}</span>
        </div>
      )}

      {/* Pílulas de Navegação das Ferramentas / Páginas */}
      <div class="cagp-axis-pills flex items-center gap-1.5 shrink-0">
        {axis.items.map((item) => {
          const isActive = item.id === activeItemId;
          return (
            <a
              href={item.href}
              class={`cagp-axis-pill min-h-[44px] px-3 py-1.5 rounded-lg flex items-center gap-1.5 text-xs font-['Oswald'] uppercase tracking-tight transition-all duration-150 no-underline shrink-0 ${
                isActive
                  ? 'bg-[#8B1E2D] text-[#FFFFFF] font-bold border-2 border-[#0A0A0A] shadow-[2px_2px_0px_#0A0A0A]'
                  : 'bg-[#F7F5F0] text-[#0A0A0A] font-semibold border border-[#DFDBD2] hover:bg-[#EAE6DE] hover:border-[#0A0A0A]'
              }`}
              aria-current={isActive ? 'page' : undefined}
              title={item.description}
            >
              <i class={`bi ${item.icon} text-sm ${isActive ? 'text-[#FFFFFF]' : 'text-gray-600'}`} aria-hidden="true" />
              <span class="hidden sm:inline">{item.label}</span>
              <span class="inline sm:hidden">{item.shortLabel}</span>
            </a>
          );
        })}
      </div>
    </div>
  </nav>
)}

<style>
  .cagp-axis-navbar-container {
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x mandatory;
    touch-action: pan-x;
  }
  .cagp-axis-pill {
    scroll-snap-align: start;
  }
  .cagp-axis-pill:active {
    transform: scale(0.96);
  }
</style>
