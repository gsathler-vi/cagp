---
// MobileDrawer.astro - Menu Lateral Off-Canvas para Telas Mobile e Tablet (< 1024px)
import { asset } from '../../lib/paths';
import { HEADER_NAV_ITEMS } from './headerNavData';

const axisSections = HEADER_NAV_ITEMS.filter((item) => Boolean(item.children && item.children.length > 0));
---

<div id="cagp-mobile-drawer" class="cagp-mobile-drawer" role="dialog" aria-modal="true" aria-label="Menu Lateral do Portal">
  <div class="cagp-drawer-backdrop" id="cagp-drawer-backdrop"></div>
  <div class="cagp-drawer-panel" role="document">
    <!-- Header do Menu -->
    <div class="cagp-drawer-header">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-lg bg-white flex items-center justify-center p-1 border-2 border-[#0A0A0A] shadow-[1.5px_1.5px_0px_#0A0A0A]">
          <img src={asset('/logos/cagp/10_simbolo_transparente_positivo.svg')} alt="Emblema Candangos CAGP" class="w-full h-full object-contain" />
        </div>
        <div>
          <span class="font-['Oswald'] font-black text-sm uppercase tracking-wide text-[#0A0A0A] block leading-none">
            Navegação Geral
          </span>
          <span class="text-[10px] text-gray-500 font-mono block mt-0.5"><strong class="text-[#8B1E2D]">CAGP</strong> FAFICH / UFMG</span>
        </div>
      </div>
      <button type="button" id="cagp-drawer-close" class="cagp-drawer-close-btn" aria-label="Fechar menu lateral">
        ✕
      </button>
    </div>

    <!-- Atalho para o Passaporte do Estudante -->
    <button
      type="button"
      id="cagp-drawer-passport-cta"
      class="mb-3 p-2.5 rounded-xl border-2 border-[#0A0A0A] bg-[#F7F5F0] hover:bg-white text-left flex items-center gap-3 shadow-[2.5px_2.5px_0px_#0A0A0A] active:scale-[0.98] transition-all cursor-pointer w-full group"
    >
      <div
        id="cagp-drawer-avatar-slot"
        class="w-10 h-10 rounded-full bg-[#8B1E2D] text-white flex items-center justify-center font-['Oswald'] font-bold text-sm border-2 border-[#0A0A0A] shadow-[1px_1px_0px_#0A0A0A] shrink-0 overflow-hidden relative"
      >
        <i class="bi bi-person-badge-fill text-lg"></i>
      </div>
      <div class="flex-1 min-w-0">
        <span
          id="cagp-drawer-student-name"
          class="font-['Oswald'] font-bold text-xs uppercase text-[#0A0A0A] block group-hover:text-[#8B1E2D] leading-tight truncate"
        >
          Passaporte Discente
        </span>
        <span
          id="cagp-drawer-student-sub"
          class="text-[10px] text-gray-500 block leading-tight mt-0.5 truncate font-mono"
        >
          Horas, Perfil & Banco de Talentos &rarr;
        </span>
      </div>
    </button>

    <!-- Seções de Navegação dos Eixos (Cards Neo-Brutalistas Estilo Desktop) -->
    <div class="space-y-1 flex-1 overflow-y-auto pr-1">
      {axisSections.map((section) => (
        <div class="cagp-drawer-section-card">
          <div class="cagp-drawer-section-header">
            <span class="cagp-drawer-section-title">{section.label}</span>
            <a href={section.href} class="cagp-drawer-section-overview-btn">
              <span>Visão Geral</span>
              <i class="bi bi-arrow-right text-xs" aria-hidden="true" />
            </a>
          </div>
          <div class="space-y-0.5">
            {section.children?.map((child) => (
              <a href={child.href} class="cagp-drawer-link group/item">
                <div class="w-7 h-7 rounded-md bg-[#F7F5F0] group-hover/item:bg-[#8B1E2D] border border-[#DFDBD2] group-hover/item:border-[#0A0A0A] flex items-center justify-center shrink-0 transition-colors">
                  <i class={`bi ${child.icon} text-sm text-[#8B1E2D] group-hover/item:text-white transition-colors`} aria-hidden="true" />
                </div>
                <div class="min-w-0 flex-1">
                  <span class="cagp-drawer-link-title group-hover/item:text-[#8B1E2D]">{child.label}</span>
                  <span class="cagp-drawer-link-desc line-clamp-1">{child.desc}</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Rodapé do Drawer com Ações Rápidas -->
    <div class="pt-3 mt-2 border-t-2 border-[#0A0A0A] flex items-center justify-between text-[11px]">
      <button
        type="button"
        id="cagp-drawer-a11y-btn"
        class="text-gray-800 hover:text-[#8B1E2D] font-['Oswald'] uppercase font-bold flex items-center gap-1.5 cursor-pointer active:scale-95 transition-transform"
      >
        <i class="bi bi-universal-access text-sm text-[#8B1E2D]"></i>
        <span>Acessibilidade</span>
      </button>
      <button
        type="button"
        id="cagp-drawer-settings-btn"
        class="text-gray-800 hover:text-[#8B1E2D] font-['Oswald'] uppercase font-bold flex items-center gap-1.5 cursor-pointer active:scale-95 transition-transform"
      >
        <i class="bi bi-gear-fill text-sm text-[#8B1E2D]"></i>
        <span>Ajustes</span>
      </button>
    </div>
  </div>
</div>
        id="cagp-drawer-a11y-btn"
        class="text-gray-700 hover:text-[#8B1E2D] font-semibold flex items-center gap-1 cursor-pointer"
      >
        <i class="bi bi-universal-access"></i> Acessibilidade
      </button>
      <button
        type="button"
        id="cagp-drawer-settings-btn"
        class="text-gray-700 hover:text-[#8B1E2D] font-semibold flex items-center gap-1 cursor-pointer"
      >
        <i class="bi bi-gear-fill"></i> Ajustes
      </button>
    </div>
  </div>
</div>

<script>
  import { renderAvatarHtml } from '../../lib/avatarHelper';

  const getDrawer = () => document.getElementById('cagp-mobile-drawer');

  const openDrawer = () => {
    const drawer = getDrawer();
    if (!drawer) return;
    drawer.classList.add('is-open');
    document.body.style.overflow = 'hidden';
    document.body.classList.add('cagp-drawer-open');
  };

  const closeDrawer = () => {
    const drawer = getDrawer();
    if (!drawer) return;
    drawer.classList.remove('is-open');
    document.body.style.overflow = '';
    document.body.classList.remove('cagp-drawer-open');
  };

  const toggleDrawer = () => {
    const drawer = getDrawer();
    if (drawer?.classList.contains('is-open')) {
      closeDrawer();
    } else {
      openDrawer();
    }
  };

  (window as any).openCagpMobileDrawer = openDrawer;
  (window as any).closeCagpMobileDrawer = closeDrawer;
  (window as any).toggleCagpMobileDrawer = toggleDrawer;

  if (!(window as any).__cagp_drawer_initialized) {
    (window as any).__cagp_drawer_initialized = true;
    window.addEventListener('cagp:open-drawer', () => (window as any).openCagpMobileDrawer?.());
    window.addEventListener('cagp:close-drawer', () => (window as any).closeCagpMobileDrawer?.());
    window.addEventListener('cagp:toggle-drawer', () => (window as any).toggleCagpMobileDrawer?.());
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        (window as any).closeCagpMobileDrawer?.();
      }
    });
    window.addEventListener('cagp:vault-updated', () => {
      (window as any).__cagp_update_drawer_avatar?.();
    });
  }

  function updateDrawerAvatar() {
    const slot = document.getElementById('cagp-drawer-avatar-slot');
    const nameEl = document.getElementById('cagp-drawer-student-name');
    const subEl = document.getElementById('cagp-drawer-student-sub');
    if (!slot) return;
    try {
      const raw = localStorage.getItem('cagp_student_profile_v1');
      const profile = raw ? JSON.parse(raw) : null;
      slot.innerHTML = renderAvatarHtml(profile, 'md');
      if (profile?.name && nameEl) {
        nameEl.textContent = profile.name;
      }
      if (profile?.period && subEl) {
        subEl.textContent = `${profile.period} • ${profile.semester || 'Ativo'} →`;
      }
    } catch (e) {
      slot.innerHTML = '<i class="bi bi-person-badge-fill text-lg"></i>';
    }
  }

  function setupMobileDrawer() {
    (window as any).__cagp_update_drawer_avatar = updateDrawerAvatar;
    closeDrawer();
    updateDrawerAvatar();

    document.getElementById('cagp-drawer-backdrop')?.addEventListener('click', closeDrawer);
    document.getElementById('cagp-drawer-close')?.addEventListener('click', closeDrawer);

    document.querySelectorAll('#cagp-mobile-drawer .cagp-drawer-link').forEach((link) => {
      link.addEventListener('click', closeDrawer);
    });

    document.getElementById('cagp-drawer-passport-cta')?.addEventListener('click', () => {
      closeDrawer();
      window.dispatchEvent(new CustomEvent('cagp:open-passport'));
    });

    document.getElementById('cagp-drawer-a11y-btn')?.addEventListener('click', () => {
      closeDrawer();
      window.dispatchEvent(new CustomEvent('cagp:open-a11y'));
    });

    document.getElementById('cagp-drawer-settings-btn')?.addEventListener('click', () => {
      closeDrawer();
      window.dispatchEvent(new CustomEvent('cagp:open-settings'));
    });
  }

  document.addEventListener('astro:page-load', setupMobileDrawer);
</script>
