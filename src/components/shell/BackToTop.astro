---
// BackToTop.astro - Botão Flutuante de Retorno ao Topo com Física Tátil
---

<button
  type="button"
  id="cagp-back-to-top"
  class="fixed bottom-20 sm:bottom-6 right-4 sm:right-6 z-[1030] p-2.5 sm:px-3 sm:py-2 bg-white/95 backdrop-blur-md text-[#0A0A0A] border-2 border-[#0A0A0A] rounded-full shadow-[3px_3px_0px_#0A0A0A] hover:bg-[#F7F5F0] hover:translate-x-[1px] hover:translate-y-[1px] hover:shadow-[2px_2px_0px_#0A0A0A] active:translate-x-[2px] active:translate-y-[2px] active:shadow-none transition-all duration-150 opacity-0 pointer-events-none flex items-center gap-1.5 font-['Oswald'] text-xs font-bold uppercase tracking-wider cursor-pointer"
  aria-label="Voltar ao início da página"
  title="Voltar ao Topo"
>
  <i class="bi bi-arrow-up text-sm text-[#8B1E2D]" aria-hidden="true"></i>
  <span class="hidden sm:inline">Topo</span>
</button>

<script>
  function setupBackToTop() {
    const btn = document.getElementById('cagp-back-to-top');
    if (!btn) return;

    const toggle = () => {
      if (window.scrollY > 280) {
        btn.classList.remove('opacity-0', 'pointer-events-none');
        btn.classList.add('opacity-100', 'pointer-events-auto');
      } else {
        btn.classList.add('opacity-0', 'pointer-events-none');
        btn.classList.remove('opacity-100', 'pointer-events-auto');
      }
    };

    window.addEventListener('scroll', toggle, { passive: true });
    btn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
    toggle();
  }

  document.addEventListener('astro:page-load', setupBackToTop);
</script>
