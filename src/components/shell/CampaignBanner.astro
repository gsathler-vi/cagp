---
// CampaignBanner.astro - Faixa Permanente de Transparência e Proposta da Chapa Semente (Cores: Laranja #FF8718, Roxo #5B2E85, Verde #2A6264)
---

<aside id="cagp-campaign-banner" class="w-full bg-[#5B2E85] text-white border-b-2 border-[#0A0A0A] select-none text-xs transition-all duration-200 z-[1050] relative shadow-[0_2px_8px_rgba(10,10,10,0.15)]">
  <!-- Micro-faixa Tricolor de Identidade da Chapa Semente -->
  <div class="h-[3px] w-full flex" aria-hidden="true">
    <div class="h-full w-1/3 bg-[#FF8718]"></div>
    <div class="h-full w-1/3 bg-[#5B2E85]"></div>
    <div class="h-full w-1/3 bg-[#2A6264]"></div>
  </div>

  <div class="max-w-7xl mx-auto px-3 sm:px-4 py-2 flex items-center justify-between gap-2.5">
    <div class="flex items-center gap-2.5 flex-1 min-w-0">
      <!-- Badge Principal: Chapa Semente em Laranja de Alto Contraste -->
      <span class="inline-flex items-center font-['Oswald'] text-[11px] font-bold tracking-wider uppercase bg-[#FF8718] text-[#0A0A0A] px-2.5 py-0.5 rounded-[4px] border border-[#0A0A0A] shadow-[1px_1px_0_#0A0A0A] shrink-0">
        <span class="text-xs me-1 leading-none" aria-hidden="true">🌱</span> CHAPA SEMENTE
      </span>

      <!-- Badge Secundário: Verde Petróleo da Chapa -->
      <span class="hidden md:inline-flex items-center font-['Oswald'] text-[10px] font-bold uppercase bg-[#2A6264] text-white px-2 py-0.5 rounded-[4px] border border-white/20 shrink-0">
        PROPOSTA DE GESTÃO
      </span>

      <!-- Texto Oficial com Destaque WCAG AAA -->
      <p id="cagp-banner-text" class="text-[11px] sm:text-xs text-white/95 leading-snug m-0 line-clamp-1 transition-all">
        Este portal é uma proposta e projeto da <strong class="text-[#FF8718] font-bold">Chapa Semente</strong> para a gestão do <strong>CAGP (FAFICH/UFMG)</strong>. Nosso compromisso é com os discentes: <strong>independentemente do resultado da eleição, disponibilizaremos este projeto completo para a gestão vencedora</strong>.
      </p>
    </div>

    <!-- Botão de Alternância Compacto / Expandido -->
    <button
      type="button"
      id="cagp-banner-toggle-btn"
      class="px-2.5 py-1 bg-[#2A6264] hover:bg-[#204e50] active:scale-95 text-white border border-[#FF8718]/60 rounded-[4px] text-[10px] font-mono font-bold shrink-0 flex items-center gap-1 transition-all cursor-pointer shadow-[1px_1px_0_#0A0A0A]"
      aria-expanded="false"
      aria-controls="cagp-banner-text"
      title="Alternar modo compacto do aviso da Chapa Semente"
    >
      <span id="cagp-banner-toggle-label">Expandir ▼</span>
    </button>
  </div>
</aside>

<script>
  function setupCampaignBanner() {
    const banner = document.getElementById('cagp-campaign-banner');
    const text = document.getElementById('cagp-banner-text');
    const btn = document.getElementById('cagp-banner-toggle-btn');
    const label = document.getElementById('cagp-banner-toggle-label');
    if (!banner || !text || !btn || !label) return;

    let isExpanded = localStorage.getItem('cagp_campaign_banner_expanded') === 'true';

    function renderState() {
      if (isExpanded) {
        text?.classList.remove('line-clamp-1');
        label.textContent = 'Compactar ▲';
        btn?.setAttribute('aria-expanded', 'true');
      } else {
        text?.classList.add('line-clamp-1');
        label.textContent = 'Expandir ▼';
        btn?.setAttribute('aria-expanded', 'false');
      }
    }

    btn.addEventListener('click', () => {
      isExpanded = !isExpanded;
      localStorage.setItem('cagp_campaign_banner_expanded', isExpanded ? 'true' : 'false');
      renderState();
    });

    renderState();
  }

  document.addEventListener('astro:page-load', setupCampaignBanner);
</script>
