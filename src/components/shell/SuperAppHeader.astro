---
// SuperAppHeader.astro - Topbar Adaptativa (Mobile / Tablet / Desktop) com Dropdowns e Spotlight
import { HEADER_NAV_ITEMS } from './headerNavData';
import { asset } from '../../lib/paths';
---

<header
  id="cagp-super-app-header"
  transition:persist="main-header"
  class="sticky top-0 z-[1040] w-full bg-white/94 backdrop-blur-xl border-b-2 border-[#0A0A0A] shadow-[0_2px_10px_rgba(10,10,10,0.05)] select-none transition-colors"
  style="padding-top: env(safe-area-inset-top, 0px);"
>
  <div class="max-w-7xl mx-auto px-3 sm:px-4 h-14 flex items-center justify-between gap-2 flex-nowrap whitespace-nowrap overflow-x-clip">
    <!-- Brand / Logo -->
    <a href="/" class="flex items-center gap-2 text-inherit no-underline min-h-[44px] shrink-0 active:scale-95 transition-transform" aria-label="Página Inicial CAGP">
      <div class="w-9 h-9 rounded-lg bg-white flex items-center justify-center p-1 border-2 border-[#0A0A0A] shadow-[2px_2px_0px_#0A0A0A] shrink-0">
        <img src={asset('/logos/cagp/10_simbolo_transparente_positivo.svg')} alt="Emblema Candangos CAGP" class="w-full h-full object-contain" />
      </div>
      <div class="leading-tight">
        <span class="block font-['Oswald'] font-black text-sm tracking-wide uppercase">
          <span class="text-[#8B1E2D]">CAGP</span> <span class="text-[#0A0A0A]">UFMG</span>
        </span>
        <span class="hidden xl:block text-[11px] text-gray-500 font-mono">FAFICH • Campus Pampulha</span>
      </div>
    </a>

    <!-- Desktop Navigation (lg: 1024px+) -->
    <nav class="hidden lg:flex items-center gap-0.5 xl:gap-1 shrink-0" aria-label="Navegação desktop dos 5 eixos">
      <!-- 1. Início -->
      <a
        href="/"
        class="cagp-island-nav-link px-2.5 py-1.5 rounded-lg font-['Inter'] font-semibold text-xs text-gray-800 hover:bg-[#F7F5F0] hover:text-[#8B1E2D] transition-colors no-underline h-9 flex items-center border border-transparent whitespace-nowrap"
        data-route="/"
      >
        Início
      </a>

      <!-- 2 a 5. Dropdowns dos 4 Eixos -->
      {HEADER_NAV_ITEMS.filter(item => item.children).map((item, idx) => (
        <div class="cagp-island-dropdown relative shrink-0" data-dropdown={item.href}>
          <button
            type="button"
            class="cagp-island-dropdown-btn px-2 xl:px-2.5 py-1.5 rounded-lg font-['Inter'] font-semibold text-xs text-gray-800 hover:bg-[#F7F5F0] hover:text-[#8B1E2D] flex items-center gap-1 transition-colors h-9 cursor-pointer border border-transparent whitespace-nowrap"
            aria-expanded="false"
            aria-haspopup="true"
          >
            <span>{item.label}</span>
            <i class="bi bi-chevron-down text-[10px] text-gray-500 cagp-island-dropdown-chevron" aria-hidden="true" />
          </button>
          <div class={`cagp-island-dropdown-menu absolute ${idx >= 2 ? 'right-0' : 'left-0'} top-full pt-1.5 z-[1050] min-w-[300px]`}>
            <div class="bg-white/98 backdrop-blur-xl border-2 border-[#0A0A0A] rounded-xl shadow-[4px_4px_0px_#0A0A0A] p-2 space-y-1">
              <a
                href={item.href}
                class="px-2.5 py-1.5 bg-[#F7F5F0] hover:bg-[#8B1E2D] hover:text-white rounded-lg flex items-center justify-between no-underline transition-colors group/header border border-[#DFDBD2]"
              >
                <span class="font-['Oswald'] font-bold text-xs uppercase tracking-wide">Visão Geral do Eixo</span>
                <span class="text-xs font-mono group-hover/header:translate-x-0.5 transition-transform">Ver Página &rarr;</span>
              </a>
              <div class="border-t border-[#DFDBD2] my-1" />
              {item.children?.map((child) => (
                <a
                  href={child.href}
                  class="cagp-island-dropdown-item p-2 rounded-lg hover:bg-[#F7F5F0] flex items-start gap-2.5 no-underline transition-colors block text-left group/item"
                  data-route={child.href}
                >
                  <i class={`bi ${child.icon} text-base text-[#8B1E2D] mt-0.5 group-hover/item:scale-110 transition-transform shrink-0`} aria-hidden="true" />
                  <div class="min-w-0">
                    <span class="font-['Oswald'] font-bold text-xs uppercase text-[#0A0A0A] block leading-tight">{child.label}</span>
                    <span class="text-xs text-gray-500 block leading-tight mt-0.5">{child.desc}</span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </div>
      ))}
    </nav>

    <!-- Quick Actions & Tools -->
    <div class="flex items-center gap-1.5 shrink-0">
      <!-- Spotlight Search Button (Desktop md+) -->
      <button
        type="button"
        id="cagp-btn-spotlight-desktop"
        class="hidden md:inline-flex items-center justify-between gap-2 h-9 px-3 w-36 lg:w-40 xl:w-52 rounded-lg border-2 border-[#0A0A0A] bg-[#F7F5F0] hover:bg-white text-xs text-gray-700 shadow-[1.5px_1.5px_0px_#0A0A0A] active:scale-[0.98] transition-all cursor-pointer shrink-0"
        aria-label="Buscar no portal"
      >
        <div class="flex items-center gap-1.5 text-gray-600 truncate">
          <i class="bi bi-search text-xs" aria-hidden="true" />
          <span class="text-xs truncate">Buscar...</span>
        </div>
        <kbd class="text-[10px] bg-white border border-[#0A0A0A] rounded px-1.5 py-0.5 font-mono font-bold text-gray-700 shrink-0">⌘K</kbd>
      </button>

      <!-- Spotlight Search Button (Mobile/Tablet < md) -->
      <button
        type="button"
        id="cagp-btn-spotlight-mobile"
        class="md:hidden w-9 h-9 min-w-[36px] min-h-[36px] flex items-center justify-center rounded-lg border-2 border-[#0A0A0A] bg-white text-[#0A0A0A] hover:bg-[#F7F5F0] shadow-[1.5px_1.5px_0px_#0A0A0A] active:scale-95 transition-all cursor-pointer shrink-0"
        aria-label="Abrir busca rápida"
      >
        <i class="bi bi-search text-sm" aria-hidden="true" />
      </button>

      <!-- Live Campus Pill (Desktop xl+) -->
      <button
        type="button"
        id="cagp-btn-campus-desktop"
        class="hidden xl:inline-flex items-center gap-1.5 h-9 px-3 rounded-lg border-2 border-[#0A0A0A] bg-[#F7F5F0] hover:bg-white text-xs font-['Oswald'] uppercase font-bold tracking-wide text-[#0A0A0A] shadow-[1.5px_1.5px_0px_#0A0A0A] active:scale-[0.98] transition-all cursor-pointer shrink-0"
        aria-label="Status do campus"
      >
        <span class="w-2 h-2 rounded-full bg-[#15803D] cagp-pulse-indicator" aria-hidden="true" />
        <span>Campus Aberto</span>
      </button>

      <!-- Campus Bell (Mobile/Tablet < xl) -->
      <button
        type="button"
        id="cagp-btn-campus"
        class="xl:hidden w-9 h-9 min-w-[36px] min-h-[36px] flex items-center justify-center rounded-lg border-2 border-[#0A0A0A] bg-white text-[#0A0A0A] hover:bg-[#F7F5F0] shadow-[1.5px_1.5px_0px_#0A0A0A] active:scale-95 transition-all relative cursor-pointer shrink-0"
        aria-label="Status do campus"
      >
        <i class="bi bi-bell text-base" aria-hidden="true" />
        <span class="absolute top-1.5 right-1.5 w-2 h-2 rounded-full bg-[#15803D] cagp-pulse-indicator" />
      </button>

      <!-- A11y Sheet Button (Desktop 2xl+) -->
      <button
        type="button"
        id="cagp-btn-a11y"
        class="hidden 2xl:flex w-9 h-9 min-w-[36px] min-h-[36px] items-center justify-center rounded-lg border-2 border-[#0A0A0A] bg-white text-[#0A0A0A] hover:bg-[#F7F5F0] shadow-[1.5px_1.5px_0px_#0A0A0A] active:scale-95 transition-all cursor-pointer shrink-0"
        aria-label="Opções de acessibilidade (Alt + A)"
        title="Acessibilidade (Alt + A)"
      >
        <i class="bi bi-universal-access text-base" aria-hidden="true" />
      </button>

      <!-- Settings Button (Desktop 2xl+) -->
      <button
        type="button"
        id="cagp-btn-settings"
        class="hidden 2xl:flex w-9 h-9 min-w-[36px] min-h-[36px] items-center justify-center rounded-lg border-2 border-[#0A0A0A] bg-white text-[#0A0A0A] hover:bg-[#F7F5F0] shadow-[1.5px_1.5px_0px_#0A0A0A] active:scale-95 transition-all cursor-pointer shrink-0"
        aria-label="Abrir configurações e sincronização do Super App (Alt + S)"
        title="Configurações & Sincronização (Alt + S)"
      >
        <i class="bi bi-gear-fill text-sm text-gray-700" aria-hidden="true" />
      </button>

      <!-- Student Passport Avatar -->
      <button
        type="button"
        id="cagp-btn-passport"
        class="w-9 h-9 min-w-[36px] min-h-[36px] flex items-center justify-center rounded-lg bg-white border-2 border-[#0A0A0A] text-[#8B1E2D] hover:bg-[#F7F5F0] shadow-[1.5px_1.5px_0px_#0A0A0A] active:scale-95 transition-all cursor-pointer overflow-hidden relative shrink-0"
        aria-label="Abrir passaporte discente"
        title="Passaporte Discente"
      >
        <span id="cagp-header-avatar-slot" class="w-full h-full flex items-center justify-center text-xs font-['Oswald'] font-bold">
          <i class="bi bi-person-fill text-base" aria-hidden="true" />
        </span>
      </button>

      <!-- Hamburger Menu Button (Mobile/Tablet: < lg) -->
      <button
        type="button"
        id="cagp-mobile-menu-btn"
        class="lg:hidden w-9 h-9 min-w-[36px] min-h-[36px] flex items-center justify-center rounded-lg text-[#0A0A0A] hover:bg-[#F7F5F0] transition-all cursor-pointer border-2 border-[#0A0A0A] bg-white shadow-[1.5px_1.5px_0px_#0A0A0A] active:scale-95 shrink-0"
        aria-label="Abrir menu de navegação lateral com todas as seções"
        title="Menu Geral"
      >
        <i class="bi bi-list text-xl" aria-hidden="true" />
      </button>
    </div>
  </div>
</header>

<script>
  import { renderAvatarHtml } from '../../lib/avatarHelper';

  function setupHeaderListeners() {
    const dispatch = (evt: string) => window.dispatchEvent(new CustomEvent(evt));
    document.getElementById('cagp-btn-spotlight-desktop')?.addEventListener('click', () => dispatch('cagp:open-spotlight'));
    document.getElementById('cagp-btn-spotlight-mobile')?.addEventListener('click', () => dispatch('cagp:open-spotlight'));
    document.getElementById('cagp-btn-campus-desktop')?.addEventListener('click', () => dispatch('cagp:open-campus'));
    document.getElementById('cagp-btn-campus')?.addEventListener('click', () => dispatch('cagp:open-campus'));
    document.getElementById('cagp-btn-a11y')?.addEventListener('click', () => dispatch('cagp:open-a11y'));
    document.getElementById('cagp-btn-settings')?.addEventListener('click', () => dispatch('cagp:open-settings'));
    document.getElementById('cagp-btn-passport')?.addEventListener('click', () => dispatch('cagp:open-passport'));
    document.getElementById('cagp-mobile-menu-btn')?.addEventListener('click', (e) => {
      e.stopPropagation();
      dispatch('cagp:toggle-drawer');
    });

    // Dropdowns interativos (Desktop)
    const dropdowns = document.querySelectorAll<HTMLElement>('.cagp-island-dropdown');

    dropdowns.forEach((dd) => {
      const btn = dd.querySelector<HTMLButtonElement>('.cagp-island-dropdown-btn');
      if (!btn) return;

      btn.onclick = (e) => {
        e.stopPropagation();
        const isOpen = dd.classList.contains('is-open');

        dropdowns.forEach((d) => {
          d.classList.remove('is-open');
          d.querySelector('.cagp-island-dropdown-btn')?.setAttribute('aria-expanded', 'false');
        });

        if (!isOpen) {
          dd.classList.add('is-open');
          btn.setAttribute('aria-expanded', 'true');
        }
      };
    });

    // Fechar dropdowns ao clicar fora
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      if (!target?.closest('.cagp-island-dropdown')) {
        dropdowns.forEach((d) => {
          d.classList.remove('is-open');
          d.querySelector('.cagp-island-dropdown-btn')?.setAttribute('aria-expanded', 'false');
        });
      }
    });

    // Atalhos Globais e Tecla Esc (vinculados uma única vez ao window)
    if (!(window as any).__cagp_header_events_bound) {
      (window as any).__cagp_header_events_bound = true;
      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          document.querySelectorAll('.cagp-island-dropdown.is-open').forEach((d) => {
            d.classList.remove('is-open');
            d.querySelector('.cagp-island-dropdown-btn')?.setAttribute('aria-expanded', 'false');
          });
        } else if (e.altKey && (e.key === 'a' || e.key === 'A')) {
          e.preventDefault();
          window.dispatchEvent(new CustomEvent('cagp:open-a11y'));
        } else if (e.altKey && (e.key === 's' || e.key === 'S')) {
          e.preventDefault();
          window.dispatchEvent(new CustomEvent('cagp:open-settings'));
        }
      });
      window.addEventListener('cagp:vault-updated', () => {
        (window as any).__cagp_update_avatar?.();
      });
    }

    // Sincronizar Rota Ativa no Cabeçalho
    const currentPath = window.location.pathname.replace(/\/$/, '') || '/';
    const homeLink = document.querySelector<HTMLAnchorElement>('.cagp-island-nav-link');
    if (homeLink) {
      const isHome = currentPath === '/' || currentPath === '';
      homeLink.classList.toggle('is-active', isHome);
      if (isHome) homeLink.setAttribute('aria-current', 'page');
      else homeLink.removeAttribute('aria-current');
    }

    dropdowns.forEach((dd) => {
      const items = dd.querySelectorAll<HTMLAnchorElement>('.cagp-island-dropdown-item');
      let parentActive = false;
      items.forEach((item) => {
        const rawHref = item.getAttribute('href') || '';
        const hrefPath = rawHref.split('#')[0].replace(/\/$/, '') || '/';
        const isMatch = hrefPath === currentPath || (currentPath === '/estagio-tcc' && hrefPath === '/estagio');
        item.classList.toggle('is-active', isMatch);
        if (isMatch) parentActive = true;
      });

      const btn = dd.querySelector<HTMLButtonElement>('.cagp-island-dropdown-btn');
      if (btn) {
        btn.classList.toggle('is-active', parentActive);
      }
    });

    // Sincronizar Avatar do Passaporte
    const updateHeaderAvatar = () => {
      const slot = document.getElementById('cagp-header-avatar-slot');
      if (!slot) return;
      try {
        const raw = localStorage.getItem('cagp_student_profile_v1');
        const profile = raw ? JSON.parse(raw) : null;
        slot.innerHTML = renderAvatarHtml(profile, 'sm');
      } catch (e) {
        slot.innerHTML = '<i class="bi bi-person-fill text-lg" aria-hidden="true" />';
      }
    };

    (window as any).__cagp_update_avatar = updateHeaderAvatar;
    updateHeaderAvatar();
  }

  document.addEventListener('astro:page-load', setupHeaderListeners);
</script>
