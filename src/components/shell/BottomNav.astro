---
// BottomNav.astro - Barra Inferior com Atalhos Customizáveis & transition:persist (Mobile & Tablet)
import { SHORTCUTS_CATALOG, DEFAULT_SHORTCUT_IDS } from '../../lib/shortcutsCatalog';
---

<nav
  id="cagp-bottom-nav"
  transition:persist="main-bottom-nav"
  class="lg:hidden fixed left-2.5 right-2.5 max-w-lg mx-auto z-[1040] bg-white/92 backdrop-blur-xl border-2 border-[#0A0A0A] rounded-full shadow-[3px_3px_0px_#0A0A0A] px-2 py-1 select-none"
  style="bottom: calc(0.5rem + env(safe-area-inset-bottom, 0px));"
  aria-label="Navegação Principal do Super App"
  data-catalog={JSON.stringify(SHORTCUTS_CATALOG)}
  data-defaults={JSON.stringify(DEFAULT_SHORTCUT_IDS)}
>
  <div id="cagp-bottom-nav-container" class="w-full flex items-center justify-around gap-0.5">
    <!-- Renderizado Inicialmente com os 5 Eixos Canônicos (Zero CLS) -->
    {DEFAULT_SHORTCUT_IDS.map((id) => {
      const item = SHORTCUTS_CATALOG.find((s) => s.id === id) || SHORTCUTS_CATALOG[0];
      return (
        <a
          href={item.href}
          data-shortcut-id={item.id}
          data-match={JSON.stringify(item.match)}
          data-action={item.isAction ? item.actionEvent : undefined}
          class="cagp-nav-item flex flex-col items-center justify-center min-w-[48px] sm:min-w-[54px] min-h-[44px] py-0.5 px-1 text-gray-700 hover:text-[#8B1E2D] no-underline group cursor-pointer"
        >
          <div class="cagp-nav-icon-circle w-9 h-9 rounded-full flex items-center justify-center transition-all duration-300">
            <i class={`bi ${item.icon} text-base sm:text-lg`} aria-hidden="true"></i>
          </div>
          <span class="cagp-nav-label text-[9px] sm:text-[10px] font-['Oswald'] font-semibold uppercase tracking-tight mt-0.5 transition-colors">{item.label}</span>
        </a>
      );
    })}

    <!-- Botão Rápido de Personalização -->
    <button
      type="button"
      id="cagp-bottom-nav-customize-btn"
      class="cagp-nav-item flex flex-col items-center justify-center min-w-[40px] min-h-[44px] py-0.5 px-1 text-gray-400 hover:text-[#8B1E2D] cursor-pointer border-none bg-transparent group"
      title="Personalizar atalhos da barra"
      aria-label="Personalizar atalhos da barra inferior"
    >
      <div class="cagp-nav-icon-circle w-9 h-9 rounded-full flex items-center justify-center transition-all duration-300">
        <i class="bi bi-sliders2 text-sm sm:text-base" aria-hidden="true"></i>
      </div>
      <span class="cagp-nav-label text-[9px] font-['Oswald'] font-semibold uppercase tracking-tight mt-0.5 transition-colors">Editar</span>
    </button>
  </div>
</nav>

<style>
  .cagp-nav-item {
    position: relative;
    user-select: none;
    outline: none;
  }
  .cagp-nav-icon-circle {
    background: transparent;
    border: 2px solid transparent;
    color: #4B5563;
    transition: all 0.28s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .cagp-nav-item:hover .cagp-nav-icon-circle {
    background: #F7F5F0;
    color: #8B1E2D;
    transform: scale(1.08);
  }
  .cagp-nav-item:active .cagp-nav-icon-circle {
    transform: scale(0.92);
  }
  .cagp-nav-item.is-active .cagp-nav-icon-circle {
    background-color: #8B1E2D !important;
    color: #FFFFFF !important;
    border: 2px solid #0A0A0A;
    box-shadow: 2px 2px 0px #0A0A0A;
    transform: scale(1.1) translateY(-2px);
  }
  .cagp-nav-item.is-active .cagp-nav-icon-circle i {
    color: #FFFFFF !important;
  }
  .cagp-nav-item.is-active .cagp-nav-label {
    color: #8B1E2D !important;
    font-weight: 700;
  }
  .cagp-nav-label {
    color: #6B7280;
  }
</style>

<script>
  function setupBottomNav() {
    const nav = document.getElementById('cagp-bottom-nav');
    const container = document.getElementById('cagp-bottom-nav-container');
    if (!nav || !container) return;

    const catalogRaw = nav.getAttribute('data-catalog');
    const defaultsRaw = nav.getAttribute('data-defaults');
    if (!catalogRaw || !defaultsRaw) return;

    let catalog: any[] = [];
    let defaults: string[] = [];
    try {
      catalog = JSON.parse(catalogRaw);
      defaults = JSON.parse(defaultsRaw);
    } catch {
      return;
    }

    const catalogMap = new Map(catalog.map((c) => [c.id, c]));

    function getSelectedIds(): string[] {
      try {
        const raw = localStorage.getItem('cagp_discente_shortcuts_v1');
        if (raw) {
          const parsed = JSON.parse(raw);
          if (Array.isArray(parsed) && parsed.length >= 1) return parsed;
        }
      } catch {}
      return defaults;
    }

    function renderNav() {
      if (!container) return;
      const selectedIds = getSelectedIds();
      const baseUrl = (document.documentElement.dataset.baseUrl || '/').replace(/\/$/, '');
      let currentPath = window.location.pathname;
      if (baseUrl && currentPath.startsWith(baseUrl)) {
        currentPath = currentPath.slice(baseUrl.length) || '/';
      }

      const itemsHtml = selectedIds
        .map((id) => {
          const item = catalogMap.get(id) || catalog[0];
          const isAction = Boolean(item.isAction && item.actionEvent);
          const matchPatterns = item.match || [];
          const isMatched = matchPatterns.some((pattern: string) => {
            const regex = new RegExp(pattern);
            return regex.test(currentPath) || (pattern === '^/$' && (currentPath === '' || currentPath === '/index.html'));
          });

          return `
            <a
              href="${item.href}"
              data-shortcut-id="${item.id}"
              data-match='${JSON.stringify(matchPatterns)}'
              ${isAction ? `data-action="${item.actionEvent}"` : ''}
              class="cagp-nav-item flex flex-col items-center justify-center min-w-[48px] sm:min-w-[54px] min-h-[44px] py-0.5 px-1 text-gray-700 hover:text-[#8B1E2D] no-underline group cursor-pointer ${isMatched ? 'is-active' : ''}"
              ${isMatched ? 'aria-current="page"' : ''}
            >
              <div class="cagp-nav-icon-circle w-9 h-9 rounded-full flex items-center justify-center transition-all duration-300">
                <i class="bi ${item.icon} text-base sm:text-lg" aria-hidden="true"></i>
              </div>
              <span class="cagp-nav-label text-[9px] sm:text-[10px] font-['Oswald'] font-semibold uppercase tracking-tight mt-0.5 transition-colors">${item.label}</span>
            </a>
          `;
        })
        .join('');

      const editBtnHtml = `
        <button
          type="button"
          id="cagp-bottom-nav-customize-btn"
          class="cagp-nav-item flex flex-col items-center justify-center min-w-[40px] min-h-[44px] py-0.5 px-1 text-gray-400 hover:text-[#8B1E2D] cursor-pointer border-none bg-transparent group"
          title="Personalizar atalhos da barra"
          aria-label="Personalizar atalhos da barra inferior"
        >
          <div class="cagp-nav-icon-circle w-9 h-9 rounded-full flex items-center justify-center transition-all duration-300">
            <i class="bi bi-sliders2 text-sm sm:text-base" aria-hidden="true"></i>
          </div>
          <span class="cagp-nav-label text-[9px] font-['Oswald'] font-semibold uppercase tracking-tight mt-0.5 transition-colors">Editar</span>
        </button>
      `;

      container.innerHTML = itemsHtml + editBtnHtml;
      bindEvents();
    }

    function bindEvents() {
      if (!container) return;

      // Botão de editar
      const editBtn = container.querySelector('#cagp-bottom-nav-customize-btn');
      editBtn?.addEventListener('click', () => {
        window.dispatchEvent(new CustomEvent('cagp:open-shortcuts'));
      });

      // Ações especiais
      const actionLinks = container.querySelectorAll('[data-action]');
      actionLinks.forEach((link) => {
        link.addEventListener('click', (e) => {
          e.preventDefault();
          const actionEvent = link.getAttribute('data-action');
          if (actionEvent) {
            window.dispatchEvent(new CustomEvent(actionEvent));
          }
        });
      });
    }

    renderNav();
  }

  document.addEventListener('astro:page-load', setupBottomNav);
  window.addEventListener('cagp:vault-updated', (e: Event) => {
    const custom = e as CustomEvent<{ key: string }>;
    if (!custom.detail || custom.detail.key === 'cagp_discente_shortcuts_v1') {
      setupBottomNav();
    }
  });
</script>
