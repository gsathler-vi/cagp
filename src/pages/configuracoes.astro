---
// configuracoes.astro - Redirecionamento canônico para o modal global A11y & Configurações
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Abrindo Configurações..."
  description="As configurações e preferências de acessibilidade agora são acessadas diretamente pelo Bottom Sheet modal global."
>
  <div class="py-16 text-center space-y-4 max-w-lg mx-auto">
    <div class="inline-flex items-center justify-center w-14 h-14 rounded-[6px] bg-[#8B1E2D]/10 text-[#8B1E2D] border-2 border-[#8B1E2D] shadow-[2px_2px_0_#0A0A0A] text-2xl">
      <i class="bi bi-gear-fill" aria-hidden="true"></i>
    </div>
    <h1 class="font-['Oswald'] text-2xl uppercase font-bold text-[#0A0A0A] m-0">
      Painel de Configurações Global
    </h1>
    <p class="text-sm text-gray-600 leading-relaxed">
      Acessibilidade universal, alarmes de sobrevivência noturna e gestão do cofre discente agora vivem no <strong>Bottom Sheet global</strong> (atalhos <code>Alt+A</code> e <code>Alt+S</code>).
    </p>
    <div class="pt-2">
      <button
        type="button"
        onclick="window.dispatchEvent(new CustomEvent('cagp:open-settings'))"
        class="cagp-btn-primary inline-flex items-center gap-2 text-sm px-4 py-2 cursor-pointer"
      >
        <i class="bi bi-sliders" aria-hidden="true"></i>
        <span>Abrir Painel de Ajustes</span>
      </button>
    </div>
  </div>

  <script is:inline>
    window.location.replace('/?openSettings=true');
  </script>
</BaseLayout>
