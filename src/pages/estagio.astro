---
// estagio.astro - A2 Ferramenta: 2 sub-views (Art. 41 · Tutorial)
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import SegmentedControl from '../components/ui/SegmentedControl.astro';
import JourneyNav from '../components/ui/JourneyNav.astro';
import FactCheckBanner from '../components/ui/FactCheckBanner.astro';
import { Art41Simulator } from '../components/curriculum/Art41Simulator';
import EstagioTutorialTce from '../components/estagio/EstagioTutorialTce.astro';

const tabs = [
  { id: 'v1', shortLabel: 'Art. 41', fullLabel: '1. Dispensa Art. 41', hash: '#art41' },
  { id: 'v2', shortLabel: 'Tutorial', fullLabel: '2. Tutorial TCE & Modelos', hash: '#tutorial' },
];

const badges = [
  { label: '300h Obrigatórias (DCP 135/136)', variant: 'red' as const, icon: 'bi-briefcase-fill' },
  { label: 'Dispensa Art. 41 Regulamento', variant: 'dark' as const, icon: 'bi-file-earmark-check-fill' },
  { label: 'TCE via SEI UFMG', variant: 'blue' as const, icon: 'bi-journal-text' },
  { label: 'Regulamento N-20229', variant: 'green' as const, icon: 'bi-shield-check' },
];

const axisPill = {
  axisName: 'Eixo 3 · Currículo',
  axisIcon: 'bi-diagram-3',
  parentLabel: 'Currículo',
  parentHref: '/percurso',
  currentLabel: 'Estágio Supervisionado',
};
---

<BaseLayout title="Estágio Supervisionado" description="Regras do estágio supervisionado de Gestão Pública da UFMG (300h: DCP 135 e DCP 136) e simulador do Art. 41.">
  <PageHeader
    title="Estágio Supervisionado (300h)"
    subtitle="Verificador interativo de integralização por experiência profissional (Art. 41), regras do Estágio Obrigatório A e B e tutorial visual do Termo de Compromisso (TCE)."
    badges={badges}
    axisPill={axisPill}
  />

  <SegmentedControl tabs={tabs} defaultTab="v1" />

  <!-- Sub-view 1: Art. 41 -->
  <section id="ws-panel-v1" class="cagp-workspace-view space-y-4" data-ws-panel="v1">
    <FactCheckBanner
      claim="Servidor público em exercício, celetista no setor público ou comissionado tem dispensa do Estágio Supervisionado (300h)?"
      verdict="homologado"
      stampText="DISPENSA ART. 41"
      normativeSource="Art. 41 do Regulamento Versão N-20229 & Parecer CNE/CES 01/2006"
      explanation="VERDADEIRO, MAS EXIGE PROTOCOLO FORMAL NO SEI/UFMG. O discente com vínculo formal ativo na administração pública direta ou indireta pode obter a dispensa total das 300h de estágio (DCP 135 e DCP 136). Para isso, deve abrir processo eletrônico com portaria de posse, CTPS ou contrato de trabalho acompanhado de memorial descritivo de atividades correlatas à Gestão Pública."
      officialRuleExcerpt={`Regulamento do Curso — Art. 41:
O discente que comprovar exercício profissional ou estágio não-obrigatório correlato à área de Gestão Pública na administração direta ou indireta, por período mínimo regulamentar, poderá requerer a dispensa das disciplinas de Estágio Supervisionado A e B, mediante parecer fundamentado da comissão avaliadora designada pelo Colegiado.`}
    />
    <Art41Simulator client:visible />
  </section>

  <!-- Sub-view 2: Tutorial TCE & Modelos -->
  <section id="ws-panel-v2" class="cagp-workspace-view" data-ws-panel="v2" hidden>
    <EstagioTutorialTce />
  </section>

  <!-- Journey Navigation Trail -->
  <JourneyNav
    prev={{
      title: 'Extensão & Horas AAC (Calculadora 600h)',
      href: '/acg',
      desc: 'Simule suas horas de Extensão e Atividades Complementares nas 9 categorias do Art. 15.',
    }}
    next={{
      title: 'Trabalho de Conclusão de Curso (180h)',
      href: '/tcc',
      desc: 'Conheça as 4 modalidades oficiais (Art. 19), baixe o Termo de Aceite e veja as regras de banca.',
    }}
  />
</BaseLayout>
