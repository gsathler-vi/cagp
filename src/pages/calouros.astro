---
// calouros.astro - A4 Guia: 4 sub-views (Checklist · Rotina · FAFICH · FUMP)
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import SegmentedControl from '../components/ui/SegmentedControl.astro';
import JourneyNav from '../components/ui/JourneyNav.astro';
import CalourosChecklist from '../components/calouros/CalourosChecklist.astro';
import CalourosVideos from '../components/calouros/CalourosVideos.astro';
import CalourosRotina from '../components/calouros/CalourosRotina.astro';
import CalourosFafich from '../components/calouros/CalourosFafich.astro';
import CalourosFump from '../components/calouros/CalourosFump.astro';

const tabs = [
  { id: 'v1', shortLabel: 'Checklist', fullLabel: '1. Checklist 30d & Apps', hash: '#checklist' },
  { id: 'v2', shortLabel: 'Rotina', fullLabel: '2. Rotina Noturna & RU', hash: '#rotina' },
  { id: 'v3', shortLabel: 'FAFICH', fullLabel: '3. FAFICH, Sec & CEAG', hash: '#fafich' },
  { id: 'v4', shortLabel: 'FUMP', fullLabel: '4. FUMP & Permanência', hash: '#fump' },
];

const badges = [
  { label: 'Turno Noturno 19h–22h30', variant: 'red' as const, icon: 'bi-moon-stars-fill' },
  { label: 'Jantar RU II até 19h30', variant: 'dark' as const, icon: 'bi-cup-hot-fill' },
  { label: 'Circulares até 22h45', variant: 'green' as const, icon: 'bi-bus-front' },
  { label: 'CEAG FAFICH 08h–22h', variant: 'blue' as const, icon: 'bi-building' },
];

const axisPill = {
  axisName: 'Eixo 2 · Curso',
  axisIcon: 'bi-mortarboard',
  parentLabel: 'O Curso',
  parentHref: '/curso',
  currentLabel: 'Guia do Calouro',
};
---

<BaseLayout title="Guia do Calouro" description="Checklist interativo dos primeiros 30 dias na UFMG, rotina do noturno, espaços da FAFICH e assistência estudantil FUMP.">
  <PageHeader
    title="Guia de Sobrevivência do Calouro"
    subtitle="Checklist interativo dos primeiros 30 dias, rotina noturna, jantar no RU II, circulares gratuitos, secretaria Sala F-2039 e suporte FUMP."
    badges={badges}
    axisPill={axisPill}
  />

  <SegmentedControl tabs={tabs} defaultTab="v1" />

  <!-- Sub-view 1: Checklist & Tutoriais Oficiais em Vídeo -->
  <section id="ws-panel-v1" class="cagp-workspace-view space-y-4" data-ws-panel="v1">
    <CalourosChecklist />
    <CalourosVideos />
  </section>

  <!-- Sub-view 2: Rotina Noturna -->
  <section id="ws-panel-v2" class="cagp-workspace-view" data-ws-panel="v2" hidden>
    <CalourosRotina />
  </section>

  <!-- Sub-view 3: Espaços FAFICH -->
  <section id="ws-panel-v3" class="cagp-workspace-view" data-ws-panel="v3" hidden>
    <CalourosFafich />
  </section>

  <!-- Sub-view 4: FUMP & Assistência -->
  <section id="ws-panel-v4" class="cagp-workspace-view" data-ws-panel="v4" hidden>
    <CalourosFump />
  </section>

  <!-- Journey Navigation Trail -->
  <JourneyNav
    prev={{
      title: 'O Bacharelado em Gestão Pública',
      href: '/curso',
      desc: 'História, colegiado, secretaria Sala F-2039 e formas de ingresso.',
    }}
    next={{
      title: 'Percurso Curricular & Ementas (10P)',
      href: '/percurso',
      desc: 'Explore as 27 obrigatórias, os 3 percursos oficiais e grafo de pré-requisitos.',
    }}
  />
</BaseLayout>
