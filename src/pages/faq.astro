---
// faq.astro - A4 Guia: 2 sub-views (Perguntas · Acessibilidade)
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import SegmentedControl from '../components/ui/SegmentedControl.astro';
import JourneyNav from '../components/ui/JourneyNav.astro';
import NormativeDetails from '../components/ui/NormativeDetails.astro';

const tabs = [
  { id: 'v1', shortLabel: 'Perguntas', fullLabel: '1. Perguntas Frequentes', hash: '#faq' },
  { id: 'v2', shortLabel: 'Acessibilidade', fullLabel: '2. Acessibilidade & NAI', hash: '#acessibilidade' },
];

const badges = [
  { label: '9 Dúvidas Regimentais', variant: 'red' as const, icon: 'bi-question-circle-fill' },
  { label: 'Regulamento N-20229', variant: 'dark' as const, icon: 'bi-book-fill' },
  { label: 'Resoluções CEPE / UFMG', variant: 'blue' as const, icon: 'bi-shield-check' },
  { label: 'Acessibilidade NAI', variant: 'green' as const, icon: 'bi-universal-access' },
];

const faqs = [
  {
    q: '1. Como funciona o trancamento parcial e total de matrícula?',
    badge: 'Art. 48 • Mín. 180h',
    icon: 'bi-clock-history',
    cat: 'matricula',
    a: 'O trancamento parcial é o cancelamento da inscrição em uma disciplina específica, realizado no SIGA dentro do prazo do Calendário Escolar. A carga horária restante deve permanecer igual ou superior ao mínimo regimental de 180 horas (12 créditos). O trancamento total suspende todas as atividades acadêmicas do semestre. Em casos de saúde ou força maior documentalmente comprovados, o trancamento com justificativa pode ser requerido a qualquer momento no Colegiado.',
  },
  {
    q: '2. Reprovei em matéria pré-requisito. Como pedir quebra de pré-requisito?',
    badge: 'Ajuste Colegiado',
    icon: 'bi-signpost-split-fill',
    cat: 'matricula',
    a: 'Se a disciplina bloquear a matrícula na subsequente, o SIGA impedirá a inscrição automática. Contudo, durante o período de ajuste presencial com o Colegiado, o estudante pode protocolar requerimento fundamentado de quebra de pré-requisito, especialmente se estiver em fase de conclusão de curso ou se houver compatibilidade de horários atestada pelos docentes.',
  },
  {
    q: '3. O curso de Gestão Pública oferece disciplinas a distância (EaD)?',
    badge: 'Art. 42 • Máx. 20%',
    icon: 'bi-display',
    cat: 'modalidades',
    a: 'Sim! O Art. 42 do Regulamento permite a oferta de atividades didáticas em EaD até o limite máximo de 20% da carga horária total do curso. Disciplinas obrigatórias teóricas podem ofertar até 25% de sua carga (15 horas) em formato virtual. Optativas como Ética na Gestão Pública (até 50%) e Libras (100% EaD) aproveitam essa modalidade.',
  },
  {
    q: '4. Posso adiantar disciplinas por Comprovação de Conhecimentos?',
    badge: 'Art. 51 / NGG Art. 78',
    icon: 'bi-award-fill',
    cat: 'dispensa',
    a: 'Sim! Conforme o Art. 51 do Regulamento e o Art. 78 das Normas Gerais de Graduação, o estudante com extraordinário aproveitamento nos estudos demonstrado por aferição escrita e oral perante banca examinadora especial pode solicitar adiantamento de disciplinas obrigatórias, dispensando a frequência regular.',
  },
  {
    q: '5. Como funciona a Mobilidade Acadêmica e Intercâmbio Internacional?',
    badge: 'Art. 52 • DRI / ANDIFES',
    icon: 'bi-airplane-fill',
    cat: 'modalidades',
    a: 'O Art. 52 assegura ao discente o direito de realizar mobilidade acadêmica mantendo o vínculo com a UFMG. O intercâmbio internacional é gerenciado pela DRI/UFMG com seleção semestral e oferta de disciplinas de Inglês para Fins Acadêmicos (IFA). O intercâmbio nacional ocorre via convênio ANDIFES/PROGRAD. O plano de estudos no exterior deve ser previamente aprovado pelo Colegiado.',
  },
  {
    q: '6. Já trabalho no setor público. Preciso fazer o Estágio Obrigatório?',
    badge: 'Art. 41 • Setor Público',
    icon: 'bi-briefcase-fill',
    cat: 'dispensa',
    a: 'Não necessariamente! Conforme o Art. 41 do Regulamento, se você possui vínculo de trabalho (efetivo ou contratado) em órgãos governamentais ou entidades públicas, pode solicitar dispensa com integralização curricular apresentando declaração da chefia no início do semestre e relatório de atividades ao final.',
  },
  {
    q: '7. Como funciona o atendimento presencial para estudantes do turno noturno?',
    badge: 'Sala F-2033 & F-2039',
    icon: 'bi-moon-stars-fill',
    cat: 'modalidades',
    a: 'O CEAG FAFICH (Central de Atendimento à Graduação • Sala F-2033) funciona de segunda a sexta, das 08h00 às 22h00 ininterruptamente no período letivo, cobrindo todo o turno noturno. A Secretaria do Curso de Gestão Pública (Sala F-2039 com Norma Guedes) atende terças presenciais (16h30–19h30) e segundas/quartas no CEAG (16h00–22h00). E-mail: coordgestaopublica@gmail.com.',
  },
  {
    q: '8. Qual o prazo máximo para pedir aproveitamento de estudos?',
    badge: 'Res. CEPE 06/2019',
    icon: 'bi-calendar-check-fill',
    cat: 'dispensa',
    a: 'Conforme o Art. 2º, inciso I da Resolução CEPE nº 06/2019, o requerimento de aproveitamento de estudos realizados em outras instituições de ensino superior só pode ser submetido até o final do 2º período letivo no curso. Após esse prazo decadencial, extingue-se o direito de requerer convalidação.',
  },
  {
    q: '9. O que é o Programa de Imersão e os Laboratórios de Gestão A e B?',
    badge: 'SIEX 109111 / 109109',
    icon: 'bi-geo-alt-fill',
    cat: 'modalidades',
    a: 'Criado pelo Colegiado em 2017/2, o Programa de Imersão integra ensino e extensão por meio das matérias obrigatórias de Laboratório de Gestão e Políticas Públicas A e B (7º e 8º períodos). Os discentes produzem diagnósticos e planos de ação para órgãos e prefeituras reais, contabilizando horas de extensão no SIEX (nº 109111 e nº 109109).',
  },
];
---

<BaseLayout title="Dúvidas Frequentes & Acessibilidade" description="Perguntas frequentes regimentais e recursos de acessibilidade institucional do curso de Gestão Pública UFMG.">
  <PageHeader
    title="Perguntas Frequentes & Acessibilidade"
    subtitle="Respostas regimentais sobre trancamento, pré-requisitos, dispensa de estágio (Art. 41), EaD, turno noturno e recursos de inclusão NAI/UFMG."
    badges={badges}
  />

  <SegmentedControl tabs={tabs} defaultTab="v1" />

  <!-- Sub-view 1: Perguntas Frequentes -->
  <section id="ws-panel-v1" class="cagp-workspace-view space-y-2" data-ws-panel="v1">
    <div class="space-y-1.5">
      {faqs.map((f) => (
        <NormativeDetails title={f.q} badge={f.badge} icon={f.icon}>
          <p class="text-xs text-gray-700 leading-relaxed">{f.a}</p>
        </NormativeDetails>
      ))}
    </div>
  </section>

  <!-- Sub-view 2: Acessibilidade & NAI -->
  <section id="ws-panel-v2" class="cagp-workspace-view space-y-3" data-ws-panel="v2" hidden>
    <div id="acessibilidade" class="cagp-tool-box p-4 space-y-3 text-xs text-gray-700 leading-relaxed">
      <div class="flex items-center justify-between border-b border-[#DFDBD2] pb-2 flex-wrap gap-2">
        <div class="flex items-center gap-2">
          <i class="bi bi-universal-access text-[#8B1E2D] text-lg" aria-hidden="true"></i>
          <h3 class="font-['Oswald'] font-bold text-sm uppercase text-[#0A0A0A]">
            Núcleo de Acessibilidade e Inclusão (NAI/UFMG)
          </h3>
        </div>
        <span class="cagp-badge cagp-badge-green font-mono">
          Apoio Pedagógico
        </span>
      </div>

      <p>
        O NAI assessora estudantes com deficiência física, visual, auditiva, transtorno do espectro autista e altas habilidades, garantindo mediação pedagógica, adaptação de provas e tecnologias assistivas.
      </p>

      <div class="p-3 bg-white rounded-[6px] border border-[#DFDBD2] space-y-1 shadow-[1px_1px_0_#0A0A0A]">
        <p><strong>Contato Oficial:</strong> <span class="font-mono text-[#8B1E2D] font-bold">nai@ufmg.br</span> • Tel: (31) 3409-4090</p>
        <p><strong>Atendimento Presencial:</strong> Prédio da Biblioteca Central da UFMG, 1º Andar, Campus Pampulha</p>
        <p><strong>Equipe de Tradutores-Intérpretes de Libras:</strong> Suporte em aulas expositivas e eventos acadêmicos</p>
      </div>

      <div class="pt-1">
        <button
          type="button"
          onclick="window.dispatchEvent(new CustomEvent('cagp:open-a11y'))"
          class="cagp-btn-primary inline-flex items-center gap-1.5 text-xs py-1.5 px-3"
        >
          <i class="bi bi-universal-access" aria-hidden="true"></i> Abrir Painel de Acessibilidade do Super App
        </button>
      </div>
    </div>
  </section>

  <!-- Journey Navigation Trail -->
  <JourneyNav
    prev={{
      title: 'Acervo de Documentos & Modelos',
      href: '/documentos',
      desc: 'Acesse o PPC, Regulamento, Ementário, Regimento CAGP e formulários oficiais.',
    }}
    next={{
      title: 'Sobre o CAGP & Governança Discente',
      href: '/sobre',
      desc: 'Regimento Interno 2024, as 7 Diretorias Executivas, Assembleia Geral e Os Candangos.',
    }}
  />
</BaseLayout>
