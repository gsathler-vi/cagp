---
// mapa-do-site.astro - Redirecionamento canônico para FAQ e Busca Rápida
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Redirecionando para Central de Dúvidas & FAQ..."
  description="A navegação panorâmica foi integrada ao Spotlight (⌘K) e ao Guia de Perguntas Frequentes em /faq."
>
  <div class="py-16 text-center space-y-4 max-w-lg mx-auto">
    <div class="inline-flex items-center justify-center w-14 h-14 rounded-[6px] bg-[#005A9C]/10 text-[#005A9C] border-2 border-[#005A9C] shadow-[2px_2px_0_#0A0A0A] text-2xl">
      <i class="bi bi-compass-fill" aria-hidden="true"></i>
    </div>
    <h1 class="font-['Oswald'] text-2xl uppercase font-bold text-[#0A0A0A] m-0">
      Navegação Panorâmica Integrada
    </h1>
    <p class="text-sm text-gray-600 leading-relaxed">
      Todas as seções do portal estão indexadas na <strong>Busca Rápida</strong> (atalho <code>⌘K</code>) e na <strong>Central de Dúvidas & FAQ</strong> em <code>/faq</code>.
    </p>
    <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
      <a href="/faq" class="cagp-btn-primary inline-flex items-center gap-2 text-sm px-4 py-2">
        <span>Acessar FAQ Geral</span>
        <i class="bi bi-arrow-right" aria-hidden="true"></i>
      </a>
      <button
        type="button"
        onclick="window.dispatchEvent(new CustomEvent('cagp:open-spotlight'))"
        class="cagp-btn-secondary inline-flex items-center gap-2 text-sm px-4 py-2 cursor-pointer"
      >
        <i class="bi bi-search" aria-hidden="true"></i>
        <span>Abrir Busca Rápida (⌘K)</span>
      </button>
    </div>
  </div>

  <script is:inline>
    window.location.replace('/faq');
  </script>
</BaseLayout>
