---
// acg.astro - A2 Ferramenta: 3 sub-views (Calculadora · 120 dias · Guia)
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import SegmentedControl from '../components/ui/SegmentedControl.astro';
import JourneyNav from '../components/ui/JourneyNav.astro';
import FactCheckBanner from '../components/ui/FactCheckBanner.astro';
import { Calculator600h } from '../components/calculators/Calculator600h';
import { Guardian120d } from '../components/calculators/Guardian120d';
import AcgGuiaTramitacao from '../components/acg/AcgGuiaTramitacao.astro';

const tabs = [
  { id: 'v1', shortLabel: 'Calculadora', fullLabel: '1. Calculadora 600h', hash: '#calculadora-horas' },
  { id: 'v2', shortLabel: '120 dias', fullLabel: '2. Guardião 120 Dias', hash: '#guardiao-120-dias' },
  { id: 'v3', shortLabel: 'Guia', fullLabel: '3. Guia & Tramitação', hash: '#guia-tramitacao' },
];

const badges = [
  { label: '300h Extensão (CEPE 10/19)', variant: 'red' as const, icon: 'bi-people-fill' },
  { label: 'Até 300h AAC (Art. 15)', variant: 'dark' as const, icon: 'bi-award-fill' },
  { label: 'Prazo Fatal 120 Dias', variant: 'gold' as const, icon: 'bi-alarm-fill' },
  { label: 'PPC N-20229', variant: 'blue' as const, icon: 'bi-shield-check' },
];

const axisPill = {
  axisName: 'Eixo 3 · Currículo',
  axisIcon: 'bi-diagram-3',
  parentLabel: 'Currículo',
  parentHref: '/percurso',
  currentLabel: 'Extensão & AAC (600h)',
};
---

<BaseLayout title="Extensão & AAC (600h)" description="Calculadora interativa de 300h de Extensão Obrigatória e 300h de AAC com monitoramento do prazo legal de 120 dias.">
  <PageHeader
    title="Extensão Obrigatória & AAC (600h)"
    subtitle="Simulador interativo com trava automática de tetos regimentais, Guardião do prazo fatal de 120 dias corridos (Art. 15, § 4º) e tutorial de tramitação oficial."
    badges={badges}
    axisPill={axisPill}
  />

  <SegmentedControl tabs={tabs} defaultTab="v1" />

  <!-- Sub-view 1: Calculadora 600h -->
  <section id="ws-panel-v1" class="cagp-workspace-view" data-ws-panel="v1">
    <Calculator600h client:load />
  </section>

  <!-- Sub-view 2: Guardião 120 Dias -->
  <section id="ws-panel-v2" class="cagp-workspace-view space-y-4" data-ws-panel="v2" hidden>
    <FactCheckBanner
      claim="Posso acumular todos os meus certificados de palestras e cursos e protocolar tudo junto no último semestre antes de colar grau?"
      verdict="atencao"
      stampText="120 DIAS CORRIDOS"
      normativeSource="Art. 15, § 4º do Regulamento do Curso Versão N-20229"
      explanation="ALERTA MÁXIMO • INDEFERIMENTO AUTOMÁTICO. O Regulamento estabelece o prazo peremptório de exatamente 120 dias corridos a contar da data de emissão do certificado ou encerramento da atividade para requerer o aproveitamento no SEI/UFMG. Certificados fora do prazo são sumariamente indeferidos pelo Colegiado, mesmo que sejam legítimos."
      officialRuleExcerpt={`Regulamento do Curso de Graduação em Gestão Pública — Versão N-20229:
Art. 15, § 4º — O discente terá o prazo máximo de 120 (cento e vinte) dias corridos, contados a partir da data de encerramento da atividade ou emissão do respectivo certificado, para requerer o aproveitamento de carga horária em Atividades Acadêmicas Complementares (AAC).
§ 5º — Expirado o prazo previsto no § 4º, o requerimento não será apreciado pela Comissão de Acompanhamento.`}
    />
    <Guardian120d client:visible />
  </section>

  <!-- Sub-view 3: Guia & Tramitação -->
  <section id="ws-panel-v3" class="cagp-workspace-view" data-ws-panel="v3" hidden>
    <AcgGuiaTramitacao />
  </section>

  <!-- Journey Navigation Trail -->
  <JourneyNav
    prev={{
      title: 'Catálogo de 68 Optativas & 120h Livre',
      href: '/optativas',
      desc: 'Consulte optativas por departamento temático e cumpra sua Formação Livre.',
    }}
    next={{
      title: 'Estágio Supervisionado (300h) & Art. 41',
      href: '/estagio',
      desc: 'Simule a dispensa por experiência profissional e consulte o tutorial de celebração do TCE.',
    }}
  />
</BaseLayout>
