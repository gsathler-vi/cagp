		<style id="wp-custom-css">
			.gb-accordion-text .wp-block-table table {
	width: 99.9%;
}

.gb-accordion-text .wp-block-table th {
  background-color: #f6f6f6;
}

.gb-accordion-text .wp-block-table td,
.gb-accordion-text .wp-block-table th {
  border: none !important;
}
.gb-accordion-text .wp-block-table tr {
  border-top: 1px solid #e6e6e6;
}

.gb-accordion-text .wp-block-table tbody {
  border-bottom: 1px solid #e6e6e6;
}

/* sidebar administrativa */

#menu-administrativo > li {
	list-style-type: none;
	color: #999;
}

#menu-administrativo a {
	text-decoration: none;
	color: #777;
	font-weight: normal;
}

#menu-administrativo a:hover {
	text-decoration: underline;
}

#menu-administrativo .current-menu-ancestor > a ,
#menu-administrativo .current-menu-item > a,
#menu-administrativo a[aria-current="page"] {
	color: #666;
	font-weight: bold;
}

#menu-administrativo .sub-menu > li {
	list-style-type: square;
}

/* nova barra de notícias */

.noticias-destacadas ul {
	padding-left: 0;
}

.noticias-destacadas li {
	list-style-type: none !important;
}

.noticias-destacadas a {
	text-decoration: none;
	color: unset;
}

/* Acessibilidade */

#gt_float_wrapper {
  top: 105px !important;
  right: 0 !important;
}
#gt_float_wrapper .gt_float_switcher {
	box-shadow: none;
	font-family: 'Open Sans', sans-serif;
	font-size: 12.8px;
	border: 1px solid #ccc;
}

#gt_float_wrapper .gt-current-lang {
	background: #fff !important;
	box-shadow: none;
	font-size: 16px;
	text-align: left;
}

.pojo-a11y-toolbar-items a:where(:not(.wp-element-button)) {
	text-decoration: none;
}

/* Ajustes visuais */

#genesis-nav-primary {
	background-color: #1F3748;
	box-shadow: 0 0 8px 5px rgba(0,0,0,0.2);
	border-bottom: 1px solid #ccc;
}

@media (max-width: 767px) {
	.mega-menu-toggle {
		background-color: #1F3748 !important;
	}
}

@media (min-width: 768px) {
	#genesis-nav-primary {
		padding: 10px 0;
	}
	#mega-menu-primary > li > a.mega-menu-link + .mega-sub-menu {
		border-top: 12px solid #1F3748 !important;
	}  
}

body {
	background-image: none;
}

.site-container {
	background: -webkit-linear-gradient(180deg,rgba(250, 245, 240, 1) 0%, rgba(255, 255, 255, 1) 100%);
	background: -moz-linear-gradient(180deg,rgba(250, 245, 240, 1) 0%, rgba(255, 255, 255, 1) 100%);
	background: linear-gradient(180deg,rgba(250, 245, 240, 1) 0%, rgba(255, 255, 255, 1) 100%);
	filter: progid:DXImageTransform.Microsoft.gradient(
  startColorstr="#FFFCF9",
  endColorstr="#FFFFFF",
  GradientType=0);	
}

		</style>
